        </WithStyles(MenuItem)>
        <WithStyles(MenuItem)
          value="Tonga Standard Time"
        >
          Nuku'alofa (UTC+13:00)
        </WithStyles(MenuItem)>
        <WithStyles(MenuItem)
          value="Samoa Standard Time"
        >
          Samoa (UTC+13:00)
        </WithStyles(MenuItem)>
      </TextField>
      <TextField
        InputLabelProps={
          Object {
            "shrink": true,
          }
        }
        className="CultureField"
        fullWidth={true}
        id="culture"
        label="Language"
        margin="normal"
        name="culture"
        required={false}
        select={true}
        variant="standard"
      >
        <WithStyles(MenuItem)
          value="fr-FR"
        >
          <span>
            <FlagIcon
              countryIsoAlpha2Code="FR"
              withRightMargin={true}
            />
            French (FR)
          </span>
        </WithStyles(MenuItem)>
        <WithStyles(MenuItem)
          value="en-US"
        >
          <span>
            <FlagIcon
              countryIsoAlpha2Code="US"
              withRightMargin={true}
            />
            English (US)
          </span>
        </WithStyles(MenuItem)>
      </TextField>
    </section>
    <section
      className="TagLabel"
    >
      <p>
        Tags
      </p>
      <Connect(ConnectedTagInput)
        allowCreate={true}
        label="Choose tags"
        onTagChange={[Function]}
        qryType="person"
        value={Array []}
      />
    </section>
  </div>
  <div
    className="Form__ActionRow"
  >
    <WithStyles(Button)
      color="primary"
      disabled={true}
      type="submit"
      variant="contained"
    >
      Create
    </WithStyles(Button)>
  </div>
</form>
`;

