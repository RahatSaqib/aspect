      InputLabelProps={
        Object {
          "shrink": true,
        }
      }
      disabled={false}
      fullWidth={true}
      id="culture"
      label="Language"
      margin="normal"
      name="culture"
      onChange={[Function]}
      required={false}
      select={true}
      variant="standard"
    >
      <WithStyles(MenuItem)
        value="fr-FR"
      >
        <span>
          <FlagIcon
            countryIsoAlpha2Code="FR"
            withRightMargin={true}
          />
          French (FR)
        </span>
      </WithStyles(MenuItem)>
      <WithStyles(MenuItem)
        value="en-US"
      >
        <span>
          <FlagIcon
            countryIsoAlpha2Code="US"
            withRightMargin={true}
          />
          English (US)
        </span>
      </WithStyles(MenuItem)>
    </TextField>
  </div>
  <div
    className="Form__ActionRow"
  >
    <WithStyles(Button)
      color="primary"
      disabled={true}
      type="submit"
      variant="contained"
    >
      Save
    </WithStyles(Button)>
  </div>
</form>
`;
