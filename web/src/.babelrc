{
  "env": {
    "test": {
      "presets": [
        [
          "env", {
            "targets": {
              "node": 6
            }
          }
        ],
        "stage-1",
        "react"
      ]
    },
    "message": {
      "plugins": [
        [
          "babel-plugin-react-intl",
          {
            "messagesDir": "./i18n"
          }
        ]
      ],
      "presets": [
        [
          "env", {
            "targets": {
              "node": 6
            }
          }
        ],
        "stage-1",
        "react"
      ]
    },
    "development": {
      "plugins": [
        [
          "react-hot-loader/babel", {
          }
        ],
      ],
      "presets": [
        [
          "env", {
            "modules": false,
            "useBuiltIns": true,
            "targets": {
              "browsers": ["last 2 versions"]
            }
          }
        ],
        "stage-1",
        "react"
      ]
    },
    "production": {
      "plugins": [
        [
          "babel-plugin-lodash", {
          }
        ]
      ],
      "presets": [
        [
          "env", {
            "modules": false,
            "useBuiltIns": true,
            "targets": {
              "browsers": ["last 2 versions"]
            }
          }
        ],
        "stage-1",
        "react"
      ]
    }
  }
}
