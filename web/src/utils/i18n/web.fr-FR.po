#. [component.Widget.stockNotRecordedDescription]
#. defaultMessage is:
#. The stock not recorded is calculated by counting all sites that didn't enter any stock for any of the GeneXpert assays and dividing that number by the total number of sites.
#: extracted_strings.json
msgid ""
"The stock not recorded is calculated by counting all sites that didn't enter "
"any stock for any of the GeneXpert assays and dividing that number by the "
"total number of sites."
msgstr ""
"Le stock non enregistré est calculé en comptant tous les sites qui n'ont "
"entré aucun stock pour aucun des tests GeneXpert et en divisant ce nombre "
"par le nombre total de sites."

#. [component.Widget.stockoutsDescription]
#. defaultMessage is:
#. The stockout percentage is calculated by counting all sites with stockout issues during the month and dividing by all active sites.
#: extracted_strings.json
msgid ""
"The stockout percentage is calculated by counting all sites with stockout "
"issues during the month and dividing by all active sites."
msgstr ""
"Le pourcentage de rupture de stock est calculé en comptant tous les sites "
"ayant des problèmes de rupture de stock au cours du mois et en divisant par "
"tous les sites actifs."

#. [component.Widget.dashboardWidgetSmsSentDescription]
#. defaultMessage is:
#. The total number of text messages sent in the month
#: extracted_strings.json
msgid "The total number of text messages sent in the month"
msgstr "Le nombre total de SMS envoyés au cours du mois"

#. [component.Widget.utilizationRateDescription]
#. defaultMessage is:
#. The utilization rate is calculated by counting all tests conducted in the month and dividing that number by the total capacity of all devices. This calculation excludes weekends.
#: extracted_strings.json
msgid ""
"The utilization rate is calculated by counting all tests conducted in the "
"month and dividing that number by the total capacity of all devices. This "
"calculation excludes weekends."
msgstr ""
"Le taux d'utilisation est calculé en comptant tous les tests effectués au "
"cours du mois et en divisant ce nombre par la capacité totale de tous les "
"appareils. Ce calcul exclut les week-ends."

