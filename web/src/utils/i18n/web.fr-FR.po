#: extracted_strings.json
msgid "The percentage of positive results that were reported via Email or SMS."
msgstr ""
"Le pourcentage de résultats positifs qui ont été signalés par e-mail ou SMS."

#. [pages.OperationalData.percentWithin2HoursDescription]
#. defaultMessage is:
#. The percentage of positive results that were reported within two hours of test completion.
#: extracted_strings.json
msgid ""
"The percentage of positive results that were reported within two hours of "
