{
  "parser": "babel-eslint",
  "plugins": [
    "react"
  ],
  "parserOptions": {
    "ecmaVersion": 6,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "env": {
    "browser": true,
    "amd": true,
    "es6": true,
    "node": true,
    "mocha": true
  },
  "extends": "airbnb",
  "rules": {
    "semi": [
      "warn",
      "never"
    ],
    "comma-dangle": "off",
    "global-require": "off",
    "newline-per-chained-call": "off",
    "no-use-before-define": "off"
  }
}
