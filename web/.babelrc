{
  "env": {
    "dev": {
      "plugins": [
        [
          "react-hot-loader/babel"
        ],
        [
          "babel-plugin-lodash",
          {}
        ]
      ]
    },
    "dist": {
      "plugins": [
        [
          "babel-plugin-lodash",
          {}
        ]
      ]
    },
    "message": {
      "plugins": [
        [
          "babel-plugin-react-intl",
          {
            "messagesDir": "./i18n"
          }
        ]
      ]
    }
  },
  "presets": [
    "es2015",
    "react",
    "stage-1"
  ]
}
