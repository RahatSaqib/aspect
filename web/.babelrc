{
  "env": {
    "dist": {
      "plugins": [
        [
          "babel-plugin-lodash",
          {}
        ]
      ]
    },
    "message": {
      "plugins": [
        [
          "babel-plugin-react-intl",
          {
            "messagesDir": "./i18n"
          }
        ]
      ]
    },
    "test": {
      "plugins": [
        [
          "babel-plugin-webpack-alias",
          {
            "config": "./webpack.config.babel.js"
          }
        ]
      ]
    }
  },
  "plugins": [
    [
      "react-hot-loader/babel"
    ]
  ],
  "presets": [
    "es2015",
    "react",
    "stage-1"
  ]
}
