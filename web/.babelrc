{
  "env": {
    "dev": {
      "plugins": [
        [
          "react-hot-loader/babel"
        ],
        [
          "babel-plugin-lodash",
          {}
        ]
      ]
    },
    "dist": {
      "plugins": [
        [
          "babel-plugin-lodash",
          {}
        ]
      ]
    },
    "message": {
      "plugins": [
        [
          "babel-plugin-react-intl",
          {
            "messagesDir": "./i18n"
          }
        ]
      ]
    }
  },
  "presets": [
    [
      "env", {
        "targets": {
          "node": 6
        }
      }
    ],
    "stage-1",
    "react"
  ]
}
