{
  "presets": [ "es2015", "react", "stage-1" ],
  "env": {
    "test": {
      "plugins": [
        [ "babel-plugin-webpack-alias", { "config": "./webpack.config.babel.js" } ]
      ]
    },
    "message": {
      "plugins": [
        [
          "babel-plugin-react-intl", {
            "messagesDir": "./i18n"
          }
        ]
      ]
    },
    "dist": {
      "plugins": [
        [ "babel-plugin-lodash", { } ]
      ]
    }
  }
}
