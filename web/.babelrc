{
  "env": {
    "message": {
      "plugins": [
        [
          "babel-plugin-react-intl",
          {
            "messagesDir": "./i18n"
          }
        ]
      ]
    }
  },
  "presets": [
    [
      "env", {
        "targets": {
          "node": 6
        }
      }
    ],
    "stage-1",
    "react"
  ]
}
