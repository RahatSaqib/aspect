{
  "name": "aspect-web",
  "private": true,
  "version": "0.0.1",
  "description": "The web client for the aspect API",
  "main": "",
  "repository": "",
  "keywords": [],
  "author": "SystemOne",
  "engines": {
    "node": "^14.18.0 || >=16.0.0"
  },
  "scripts": {
    "start": "vite --open",
    "start:fresh": "yarn && yarn start",
    "start:ci": "vite",
    "dev": "vite build --mode development",
    "dist": "vite build",
    "preview": "vite preview",
    "pretest": "fsys --task=remove --fileFolder=coverage && fsys --task=remove --fileFolder=mocha.json",
    "test": "cross-env TZ='Europe/Paris' DOTENV_CONFIG_PATH=./.env.test BABEL_ENV=test JEST_FILE=mocha.json jest --coverage",
    "test:ci": "cross-env TZ='Europe/Paris' DOTENV_CONFIG_PATH=./.env.test BABEL_ENV=test JEST_FILE=mocha.json jest --coverage",
    "test:snapshot": "npm run test -- -u",
    "test:watch": "npm run test -- --watch",
    "test:no-coverage": "TZ='Europe/Paris' DOTENV_CONFIG_PATH=./.env.test jest test --watch",
    "test:single": "TZ='Europe/Paris' DOTENV_CONFIG_PATH=./.env.test jest",
    "preupdatemessages:start": "formatjs extract \"src/**/*.{js,jsx}\" --out-file \"./extracted_strings.json\" --format \"./src/utils/i18n/formatter.js\"",
    "updatemessages:start": "rip json2pot \"./extracted_strings.json\" -o \"./src/utils/i18n/diff.pot\"",
    "updatemessages:end": "rip po2json \"./src/utils/i18n/web.*.po\" -m \"./extracted_strings.json\" -o \"./src/utils/i18n/translation.json\"",
    "postupdatemessages:end": "fsys --task=remove --fileFolder=extracted_strings.json && fsys --task=remove --fileFolder=./src/utils/i18n/diff.pot",
    "prettier": "prettier \"./src/**/*.{js,jsx,css}\" --write",
    "lint": "eslint . --report-unused-disable-directives --ext .js --ext .jsx --ext .mjs",
    "lint:changes": "eslint $(git diff --name-only --diff-filter=ACM | grep -E '\\.(js|ts|jsx|tsx)$' | sed 's|^|../|') --fix",
    "release:major": "npm version major && npm publish && git push --follow-tags",
    "release:minor": "npm version minor && npm publish && git push --follow-tags",
    "release:patch": "npm version patch && npm publish && git push --follow-tags"
  },
  "dependencies": {
    "@ant-design/plots": "^1.2.5",
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@mui/icons-material": "^5.10.14",
    "@mui/lab": "^5.0.0-alpha.124",
    "@mui/material": "^5.10.14",
    "@mui/styles": "^5.10.14",
    "@mui/x-date-pickers": "^5.0.8",
    "@react-google-maps/api": "^2.12.1",
    "@sentry/react": "^7.11.1",
    "@sentry/tracing": "^7.11.1",
    "cronstrue": "^2.11.0",
    "date-fns": "2.29.1",
    "date-fns-tz": "^2.0.0",
    "downshift": "^6.1.9",
    "email-validator": "^2.0.4",
    "formik": "^2.2.9",
    "google-libphonenumber": "^3.2.33",
    "http-client": "^4.3.1",
    "jwt-decode": "^3.1.2",
    "lodash": "^4.17.21",
    "material-ui-phone-number": "^3.0.0",
    "prop-types": "^15.8.1",
    "react": "^17.0.2",
    "react-datepicker": "^4.8.0",
    "react-dom": "^17.0.2",
    "react-error-boundary": "^3.1.4",
    "react-ga4": "^2.1.0",
    "react-google-maps": "^9.4.5",
    "react-helmet": "^6.1.0",
    "react-icons": "^4.4.0",
    "react-idle-timer": "^5.7.2",
    "react-intl": "^6.5.2",
    "react-query": "^3.39.2",
    "react-router": "6.7.0",
    "react-router-dom": "6.7.0",
    "react-select": "^5.4.0",
    "react-toastify": "9.1.3",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@babel/core": "^7.18.10",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.18.10",
    "@babel/plugin-proposal-do-expressions": "^7.18.6",
    "@babel/plugin-proposal-export-default-from": "^7.18.10",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@babel/plugin-proposal-function-sent": "^7.18.6",
    "@babel/plugin-proposal-json-strings": "^7.18.6",
    "@babel/plugin-proposal-logical-assignment-operators": "^7.18.9",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-numeric-separator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.18.9",
    "@babel/plugin-proposal-pipeline-operator": "^7.18.9",
    "@babel/plugin-proposal-throw-expressions": "^7.18.6",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-syntax-import-meta": "^7.10.4",
    "@babel/plugin-transform-runtime": "^7.18.10",
    "@babel/preset-env": "^7.18.10",
    "@babel/preset-react": "^7.18.6",
    "@formatjs/cli": "4.2.29",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^12.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@vitejs/plugin-react": "^3",
    "@wojtekmaj/enzyme-adapter-react-17": "^0.6.7",
    "babel-eslint": "^10.1.0",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "babel-plugin-lodash": "^3.3.4",
    "babel-polyfill": "^6.26.0",
    "cross-env": "^7.0.3",
    "dotenv": "^8.6.0",
    "enzyme": "^3.11.0",
    "enzyme-to-json": "^3.6.2",
    "eslint": "^7.32.0",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.6.1",
    "eslint-plugin-lodash": "^7.4.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.30.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-security": "^1.5.0",
    "eslint-plugin-small-import": "^1.0.0",
    "fs-extra-cli": "0.0.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^27.0.6",
    "jest-bamboo-formatter": "^1.0.1",
    "jest-fetch-mock": "^3.0.3",
    "prettier": "^2.7.1",
    "react-intl-po": "^2.2.2",
    "vite": "^4",
    "vite-plugin-compression": "^0.5.1"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/src/__setup__/mockDate.js",
      "<rootDir>/src/__setup__/mockFetch.js",
      "<rootDir>/src/__setup__/mockGoogle.js",
      "<rootDir>/src/__setup__/mockI18n.js",
      "<rootDir>/src/__setup__/enzyme.js",
      "dotenv/config",
      "<rootDir>/src/__setup__/appEnv.js"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/src/__mocks__/fileMock.js",
      "\\.scss$": "<rootDir>/src/__mocks__/globalStyleMock.js",
      "\\.css$": "identity-obj-proxy"
    },
    "testEnvironment": "jsdom",
    "testResultsProcessor": "jest-bamboo-formatter",
    "snapshotSerializers": [
      "enzyme-to-json/serializer"
    ],
    "coveragePathIgnorePatterns": [
      "<rootDir>/src/config.js",
      "<rootDir>/src/__mocks__",
      "<rootDir>/src/__setup__",
      "<rootDir>/src/utils",
      "<rootDir>/src/messages",
      "<rootDir>/src/providers/I18nProvider/date-fns-locales"
    ]
  },
  "resolutions": {
    "minimist": "1.2.6",
    "lodash": "^4.17.21",
    "ansi-regex": "5.0.1",
    "glob-parent": "6.0.1",
    "node-fetch": "^2.6.7",
    "node-forge": "1.3.0",
    "json-schema": "0.4.0",
    "ansi-html": "0.0.8",
    "trim-newlines": "3.0.1",
    "trim": "0.0.3",
    "jpeg-js": "0.4.4",
    "underscore": "1.12.1",
    "node-releases": "2.0.14"
  }
}
