    "@vx/grid": "^0.0.140",
    "@vx/group": "^0.0.140",
    "@vx/legend": "^0.0.140",
    "@vx/responsive": "^0.0.140",
    "@vx/scale": "^0.0.140",
    "@vx/shape": "^0.0.140",
    "classnames": "^2.2.5",
    "d3-array": "^1.2.0",
    "date-fns": "^2.0.0-alpha.1",
    "dom-helpers": "^3.2.1",
    "element-resize-detector": "^1.1.12",
    "email-validator": "^1.0.7",
    "global": "^4.3.2",
    "history": "^4.6.1",
    "http-client": "^4.3.1",
    "immutable": "^3.8.1",
    "intl": "^1.2.4",
    "invariant": "^2.2.2",
