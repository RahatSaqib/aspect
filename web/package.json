{
  "name": "aspect-web",
  "private": true,
  "version": "0.0.1",
  "description": "The web client for the aspect API",
  "main": "",
  "repository": "",
  "keywords": [],
  "author": "SystemOne",
  "scripts": {
    "start": "webpack serve --config cfg/dev.js --open --hot",
    "start:fresh": "yarn && yarn start",
    "start:ci": "webpack serve --config cfg/dev.js",
    "dev": "webpack --config cfg/dev.js",
    "dist": "webpack --config cfg/dist.js",
    "pretest": "fsys --task=remove --fileFolder=coverage && fsys --task=remove --fileFolder=mocha.json",
    "test": "cross-env TZ='Europe/Paris' DOTENV_CONFIG_PATH=./.env.test BABEL_ENV=test JEST_FILE=mocha.json jest --coverage",
    "test:ci": "cross-env TZ='Europe/Paris' DOTENV_CONFIG_PATH=./.env.test BABEL_ENV=test JEST_FILE=mocha.json jest --coverage",
    "test:snapshot": "npm run test -- -u",
    "test:watch": "npm run test -- --watch",
    "test:no-coverage": "TZ='Europe/Paris' DOTENV_CONFIG_PATH=./.env.test jest test --watch",
    "test:single": "TZ='Europe/Paris' DOTENV_CONFIG_PATH=./.env.test jest",
    "preupdatemessages:start": "formatjs extract \"src/**/*.{js,jsx}\" --out-file \"./extracted_strings.json\" --format \"./src/utils/i18n/formatter.js\"",
    "updatemessages:start": "rip json2pot \"./extracted_strings.json\" -o \"./src/utils/i18n/diff.pot\"",
    "updatemessages:end": "rip po2json \"./src/utils/i18n/web.*.po\" -m \"./extracted_strings.json\" -o \"./src/utils/i18n/translation.json\"",
    "postupdatemessages:end": "fsys --task=remove --fileFolder=extracted_strings.json && fsys --task=remove --fileFolder=./src/utils/i18n/diff.pot",
    "prettier": "prettier \"./src/**/*.{js,jsx,css}\" --write",
    "lint": "eslint . --report-unused-disable-directives --ext .js --ext .jsx",
    "release:major": "npm version major && npm publish && git push --follow-tags",
    "release:minor": "npm version minor && npm publish && git push --follow-tags",
    "release:patch": "npm version patch && npm publish && git push --follow-tags"
  },
  "dependencies": {
