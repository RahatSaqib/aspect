    "style-loader": "^0.19.0",
    "svg-sprite-loader": "^3.7.3",
    "url-loader": "^0.6.2",
    "util.promisify": "^1.0.0",
    "webapp-manifest-plugin": "^0.0.4",
    "webpack": "^3.3.0",
    "webpack-bundle-analyzer": "^2.11.1",
    "webpack-dev-server": "^2.4.2",
    "why-did-you-update": "^0.1.0"
  },
  "dependencies": {
