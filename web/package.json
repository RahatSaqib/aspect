{
  "name": "aspect-web",
  "private": true,
  "version": "0.0.1",
  "description": "The web client for the aspect API",
  "main": "",
  "scripts": {
    "start": "cross-env NODE_ENV=dev webpack-dev-server --inline --hot --open",
    "pretest": "fsys --task=remove --fileFolder=coverage && fsys --task=remove --fileFolder=mocha.json",
    "test": "cross-env ASPECT_ENV=test JEST_FILE=mocha.json jest --config ./jest.json --coverage",
    "test:watch": "npm run test -- --watch",
    "posttest": "npm run lint",
    "preupdatemessages:start": "cross-env BABEL_ENV=message babel --quiet --out-dir ./i18n/dist ./src",
    "updatemessages:start": "rip json2pot './i18n/src/**/*.json' -o ./src/shared/i18n/diff.pot",
    "updatemessages:end": "rip po2json './src/shared/i18n/web.*.po' -m './i18n/src/**/*.json' -o ./src/shared/i18n/translation.json",
    "postupdatemessages:end": "fsys --task=remove --fileFolder=i18n && fsys --task=remove --fileFolder=src/shared/i18n/diff.pot",
    "dist": "cross-env ASPECT_ENV=dist webpack",
    "lint": "eslint ./src --ext .js --ext .jsx",
    "clean": "fsys --task=emptyDir --dir=dist",
    "release:major": "npm version major && npm publish && git push --follow-tags",
    "release:minor": "npm version minor && npm publish && git push --follow-tags",
    "release:patch": "npm version patch && npm publish && git push --follow-tags"
  },
  "repository": "",
  "keywords": [],
  "author": "SystemOne",
  "devDependencies": {
    "babel-cli": "^6.18.0",
    "babel-core": "^6.18.0",
    "babel-eslint": "^7.1.1",
    "babel-loader": "^6.2.8",
    "babel-plugin-istanbul": "^3.0.0",
    "babel-plugin-lodash": "^3.2.8",
    "babel-plugin-react-intl": "^2.2.0",
    "babel-polyfill": "^6.16.0",
    "babel-preset-es2015": "^6.18.0",
    "babel-preset-react": "^6.16.0",
    "babel-preset-stage-1": "^6.16.0",
    "babel-register": "^6.18.0",
    "bower-webpack-plugin": "^0.1.9",
    "case-sensitive-paths-webpack-plugin": "^1.1.4",
    "chunk-manifest-webpack-plugin": "^0.1.0",
    "core-js": "^2.4.0",
    "cross-env": "^3.1.2",
    "css-loader": "^0.26.0",
    "enzyme": "^2.6.0",
    "eslint": "^3.10.1",
    "eslint-config-airbnb": "^13.0.0",
    "eslint-loader": "^1.5.0",
    "eslint-plugin-import": "^2.2.0",
    "eslint-plugin-jsx-a11y": "^2.2.3",
    "eslint-plugin-react": "^6.7.0",
    "expect": "^1.20.2",
    "file-loader": "^0.9.0",
    "fs-extra-cli": "0.0.4",
    "glob": "^7.0.5",
    "html-webpack-plugin": "^2.24.0",
    "html-webpack-plugin-remove": "0.0.2",
    "identity-obj-proxy": "^3.0.0",
    "istanbul": "^1.0.0-alpha.2",
    "jest": "^17.0.3",
    "jest-bamboo-formatter": "^0.0.3",
    "jsdom": "^9.8.3",
    "json-loader": "^0.5.4",
    "node-sass": "^3.13.0",
    "npm-run-all": "^3.0.0",
    "null-loader": "^0.1.1",
    "postcss": "^5.2.5",
    "postcss-loader": "^1.1.1",
    "react-addons-test-utils": "^15.4.0",
    "react-hot-loader": "^3.0.0-beta.4",
    "react-intl-po": "^1.0.6",
    "sass-loader": "^4.0.2",
    "sinon": "^1.17.6",
    "static-loader": "^0.1.8",
    "style-loader": "^0.13.0",
    "url-loader": "^0.5.6",
    "webpack": "^1.13.0",
    "webpack-dev-server": "^1.12.0",
    "webpack-manifest-plugin": "^1.0.1"
  },
  "dependencies": {
    "classnames": "^2.2.5",
    "date-fns": "^1.10.0",
    "dom-helpers": "^3.0.0",
    "email-validator": "^1.0.7",
    "es6-promise": "^4.0.5",
    "global": "^4.3.0",
    "http-client": "^4.3.1",
    "immutable": "^3.8.1",
    "intl": "^1.2.4",
    "invariant": "^2.2.2",
    "is-promise": "^2.1.0",
    "isomorphic-fetch": "^2.2.1",
    "jwt-decode": "^2.0.1",
    "keycode": "^2.1.7",
    "lodash": "^4.17.2",
    "material-ui": "^0.16.4",
    "piwik-react-router": "^0.3.1",
    "raven-js": "^3.8.1",
    "react": "^15.3.0",
    "react-display-name": "^0.2.0",
    "react-dom": "^15.4.0",
