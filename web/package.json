    "react-sparklines": "^1.5.2",
    "react-tap-event-plugin": "^2.0.1",
    "recompose": "^0.20.2",
    "redux": "^3.5.2",
    "redux-form": "^6.1.1",
    "redux-idle-monitor": "^0.5.1",
    "redux-immutable": "^3.0.0",
    "redux-thunk": "^2.1.0",
    "whatwg-fetch": "^2.0.1"
  }
}
