{
  "name": "aspect-web",
  "private": true,
  "version": "0.0.1",
  "description": "The web client for the aspect API",
  "main": "",
  "scripts": {
    "styleguide": "styleguidist server",
    "prestart": "webpack --config cfg/dll.js",
    "start": "webpack-dev-server --config cfg/src.js --open 'google chrome' --env.ASPECT_TARGET=local",
    "predist": "webpack --config cfg/dll.js",
    "dist": "webpack --config cfg/src.js --env.ASPECT_TARGET=dist",
    "pretest": "fsys --task=remove --fileFolder=coverage && fsys --task=remove --fileFolder=mocha.json",
    "test": "cross-env ASPECT_TARGET=test BABEL_ENV=test JEST_FILE=mocha.json jest --coverage",
    "test:snapshot": "npm run test -- -u",
    "test:watch": "npm run test -- --watch",
    "posttest": "npm run lint",
    "preupdatemessages:start": "cross-env BABEL_ENV=message babel --quiet --out-dir ./i18n/dist ./src",
    "updatemessages:start": "rip json2pot \"./i18n/src/**/*.json\" -o ./src/shared/i18n/diff.pot",
    "updatemessages:end": "rip po2json \"./src/shared/i18n/web.*.po\" -m \"./i18n/src/**/*.json\" -o ./src/shared/i18n/translation.json",
    "postupdatemessages:end": "fsys --task=remove --fileFolder=i18n && fsys --task=remove --fileFolder=src/shared/i18n/diff.pot",
    "prettier": "prettier --no-semi --single-quote --trailing-comma=es5",
    "prettier:write": "npm run prettier -- --write \"./src/**/*.{js,jsx,css}\"",
    "lint": "eslint . --ext .js --ext .jsx --ignore-pattern coverage/ --ignore-pattern dist/",
    "release:major": "npm version major && npm publish && git push --follow-tags",
    "release:minor": "npm version minor && npm publish && git push --follow-tags",
    "release:patch": "npm version patch && npm publish && git push --follow-tags",
    "precommit": "lint-staged"
  },
  "lint-staged": {
    "linters": {
      "web/cfg/**/*.js": [
        "eslint --fix",
        "git add"
      ],
      "web/src/**/*.css": [
        "prettier --write",
        "git add"
      ],
      "web/src/**/*.js": [
        "eslint --fix",
        "git add"
      ],
      "web/src/**/*.jsx": [
        "eslint --fix",
        "git add"
      ]
    }
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/src/__setup__/polyfills.js",
      "<rootDir>/src/__setup__/mockDate.js",
      "<rootDir>/src/__setup__/mockFetch.js",
      "<rootDir>/src/__setup__/enzyme.js",
      "<rootDir>/src/__setup__/injectTapEventPlugin.js"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/src/__mocks__/fileMock.js",
      "\\.scss$": "<rootDir>/src/__mocks__/globalStyleMock.js",
      "\\.css$": "identity-obj-proxy"
    },
    "testResultsProcessor": "jest-bamboo-formatter"
  },
  "babel": {
    "env": {
      "test": {
        "plugins": [
          "babel-plugin-dynamic-import-node"
        ],
        "presets": [
          [
            "env",
            {
              "targets": {
                "node": "current"
              }
            }
          ],
          "stage-1",
          "react"
        ]
      },
      "message": {
        "plugins": [
          [
            "babel-plugin-react-intl",
            {
              "messagesDir": "./i18n"
            }
          ]
        ],
        "presets": [
          [
            "env",
            {
              "targets": {
                "node": "current"
              }
            }
          ],
          "stage-1",
          "react"
        ]
      },
      "webpack": {
        "plugins": [
          [
            "babel-plugin-lodash",
            {}
          ],
          [
            "react-hot-loader/babel",
            {}
          ]
        ],
        "presets": [
          [
            "env",
            {
              "modules": false,
              "useBuiltIns": true,
              "targets": {
                "browsers": [
                  "last 2 versions"
                ]
              }
            }
          ],
          "stage-1",
          "react"
        ]
      }
    }
  },
  "repository": "",
  "keywords": [],
  "author": "SystemOne",
  "devDependencies": {
    "babel-cli": "^6.24.1",
    "babel-core": "^6.24.1",
    "babel-eslint": "^8.0.1",
    "babel-loader": "^7.0.0-beta.1",
    "babel-plugin-dynamic-import-node": "^1.1.0",
    "babel-plugin-lodash": "^3.2.11",
    "babel-plugin-react-intl": "^2.3.1",
    "babel-polyfill": "^6.23.0",
    "babel-preset-env": "^1.4.0",
    "babel-preset-react": "^6.24.1",
    "babel-preset-stage-1": "^6.24.1",
    "babel-register": "^6.24.1",
    "caniuse-lite": "^1.0.30000697",
    "case-sensitive-paths-webpack-plugin": "^2.0.0",
    "chunk-manifest-webpack-plugin": "^1.0.0",
    "compression-webpack-plugin": "^1.0.0",
    "core-js": "^2.4.0",
    "cross-env": "^5.0.1",
    "css-loader": "^0.28.0",
    "del-webpack-plugin": "^1.0.1",
    "enzyme": "^3.0.0",
    "enzyme-adapter-react-15": "^1.0.0",
    "eslint": "^4.4.1",
    "eslint-config-airbnb": "^16.0.0",
    "eslint-config-prettier": "^2.1.1",
    "eslint-loader": "^1.7.1",
    "eslint-plugin-import": "^2.5.0",
    "eslint-plugin-jsx-a11y": "^6.0.2",
    "eslint-plugin-prettier": "^2.1.1",
    "eslint-plugin-react": "^7.0.1",
    "extract-text-webpack-plugin": "^3.0.0",
    "favicons-webpack-plugin": "^0.0.7",
    "file-loader": "^1.1.5",
    "fs-extra-cli": "0.0.4",
    "glob": "^7.1.2",
    "html-loader": "^0.5.1",
    "html-webpack-harddisk-plugin": "^0.1.0",
    "html-webpack-include-assets-plugin": "^1.0.0",
    "html-webpack-plugin": "^2.28.0",
    "husky": "^0.14.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^21.2.0",
    "jest-bamboo-formatter": "^1.0.1",
    "jest-fetch-mock": "^1.4.0",
    "lint-staged": "^6.0.0",
    "npm-run-all": "^4.0.2",
    "null-loader": "^0.1.1",
    "postcss": "^6.0.2",
    "postcss-cssnext": "^3.0.2",
    "postcss-import": "^11.0.0",
    "postcss-loader": "^2.0.6",
    "postcss-pxtorem": "^4.0.0",
    "prettier": "^1.5.2",
