{
  "name": "aspect-web",
  "private": true,
  "version": "0.0.1",
  "description": "The web client for the aspect API",
  "main": "",
  "scripts": {
    "start": "webpack-dev-server --inline --hot --open --env=dev",
    "mocha": "mocha --opts utils/unit_tests/mocha_unit.opts",
    "run:tests:coverage": "istanbul cover --config utils/unit_tests/istanbul.yml node_modules/mocha/bin/_mocha -- --opts utils/unit_tests/mocha_unit.opts",
    "check:coverage": "istanbul check-coverage --config utils/unit_tests/istanbul.yml",
    "pretest": "fsys --task=remove --fileFolder=coverage && fsys --task=remove --fileFolder=mocha.json",
    "test": "npm-run-all run:tests:coverage check:coverage",
    "test:watch": "npm run mocha -- --watch",
    "posttest": "npm run lint",
    "preupdatemessages:start": "BABEL_ENV=message babel --quiet --out-dir ./i18n/dist ./src",
    "updatemessages:start": "rip json2pot './i18n/src/**/*.json' -o ./src/i18n/diff.pot",
    "updatemessages:end": "rip po2json './src/i18n/web.*.po' -m './i18n/src/**/*.json' -o ./src/i18n/translation.json",
    "postupdatemessages:end": "fsys --task=remove --fileFolder=i18n && fsys --task=remove --fileFolder=src/i18n/diff.pot",
    "dist": "webpack --config=webpack.config.babel.js --env=dist",
    "lint": "eslint ./src --ext .js --ext .jsx",
    "clean": "fsys --task=emptyDir --dir=dist",
    "release:major": "npm version major && npm publish && git push --follow-tags",
    "release:minor": "npm version minor && npm publish && git push --follow-tags",
    "release:patch": "npm version patch && npm publish && git push --follow-tags"
  },
  "repository": "",
  "keywords": [],
  "author": "SystemOne",
  "devDependencies": {
    "babel-cli": "^6.14.0",
    "babel-core": "^6.13.0",
    "babel-eslint": "^6.1.0",
    "babel-loader": "^6.2.0",
    "babel-plugin-lodash": "^3.2.8",
    "babel-plugin-react-intl": "^2.2.0",
    "babel-plugin-webpack-alias": "^2.1.1",
    "babel-polyfill": "^6.13.0",
    "babel-preset-es2015": "^6.13.0",
    "babel-preset-react": "^6.11.0",
    "babel-preset-stage-1": "^6.13.0",
    "babel-register": "^6.14.0",
    "bower-webpack-plugin": "^0.1.9",
    "chai": "^3.2.0",
    "chai-immutable": "^1.6.0",
    "chunk-manifest-webpack-plugin": "^0.1.0",
    "core-js": "^2.4.0",
    "css-loader": "^0.25.0",
    "enzyme": "^2.4.1",
    "eslint": "^3.6.0",
    "eslint-loader": "^1.5.0",
    "eslint-plugin-react": "^6.1.0",
    "file-loader": "^0.9.0",
    "fs-extra-cli": "0.0.4",
    "glob": "^7.0.5",
    "html-webpack-plugin": "^2.22.0",
    "html-webpack-plugin-remove": "0.0.2",
    "isparta-instrumenter-loader": "^1.0.1",
    "istanbul": "^1.0.0-alpha.2",
    "jsdom": "^9.4.0",
    "json-loader": "^0.5.4",
    "minimist": "^1.2.0",
    "mocha": "^3.0.0",
    "mocha-bamboo-reporter": "^1.1.1",
    "mocha-multi": "^0.9.1",
    "node-sass": "^3.10.0",
    "npm-run-all": "^3.0.0",
    "null-loader": "^0.1.1",
    "postcss": "^5.1.0",
    "postcss-loader": "^0.13.0",
    "react-addons-test-utils": "^15.1.0",
    "react-hot-loader": "^3.0.0-beta.4",
    "react-intl-po": "^1.0.6",
    "sass-loader": "^4.0.2",
    "static-loader": "^0.1.8",
    "style-loader": "^0.13.0",
    "url-loader": "^0.5.6",
    "webpack": "^1.13.0",
    "webpack-dev-server": "^1.12.0",
    "webpack-manifest-plugin": "^1.0.1"
  },
  "dependencies": {
    "classnames": "^2.2.5",
    "es6-promise": "^3.2.1",
    "global": "^4.3.0",
    "http-client": "^4.1.0",
    "immutable": "^3.8.1",
    "intl": "^1.2.4",
    "isomorphic-fetch": "^2.2.1",
    "jwt-decode": "^2.0.1",
    "lodash": "^4.15.0",
    "material-ui": "^0.15.0",
    "moment": "^2.13.0",
    "raven-js": "^3.7.0",
    "react": "^15.3.0",
    "react-dom": "^15.3.0",
    "react-helmet": "^3.1.0",
    "react-intl": "^2.1.5",
    "react-redux": "^4.4.5",
    "react-router": "^2.7.0",
    "react-router-scroll": "^0.3.0",
    "react-sparklines": "^1.5.2",
    "react-tap-event-plugin": "^1.0.0",
    "redux": "^3.5.2",
    "redux-form": "^6.0.2",
    "redux-immutable": "^3.0.0",
    "redux-thunk": "^2.1.0",
    "whatwg-fetch": "^1.0.0"
  }
}
