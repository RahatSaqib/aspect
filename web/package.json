{
  "name": "aspect-web",
  "private": true,
  "version": "0.0.1",
  "description": "The web client for the aspect API",
  "main": "",
  "scripts": {
    "prewebpack:dll": "fsys --task=emptyDir --dir=dist && fsys --task=remove --fileFolder=src/template/dll.vendor.manifest.json && fsys --task=remove --fileFolder=src/template/index.html",
    "webpack:dll": "webpack --config cfg/dll.babel.js",
    "prewebpack-dev-server:src": "cd src/template && fsys --task=copy --filesFolders=index.html --destination=../../dist --clobber='false' --preserveTimestamps='false' && cd ../../",
    "webpack-dev-server:src": "webpack-dev-server --config cfg/src.babel.js --inline --hot --open",
    "webpack:src": "webpack --config cfg/src.babel.js",
    "start": "npm-run-all 'webpack:dll -- --{1}' 'webpack-dev-server:src -- --{1}' -- env.ASPECT_TARGET=local",
    "dist": "npm-run-all 'webpack:dll -- --{1}' 'webpack:src -- --{1}' -- env.ASPECT_TARGET=dist",
    "pretest": "fsys --task=remove --fileFolder=coverage && fsys --task=remove --fileFolder=mocha.json",
    "test": "cross-env ASPECT_TARGET=test JEST_FILE=mocha.json jest --config ./jest.json --coverage",
    "test:snapshot": "cross-env ASPECT_TARGET=test JEST_FILE=mocha.json jest --config ./jest.json -u",
    "test:watch": "npm run test -- --watch",
    "posttest": "npm run lint",
    "preupdatemessages:start": "cross-env BABEL_ENV=message babel --quiet --out-dir ./i18n/dist ./src",
    "updatemessages:start": "rip json2pot './i18n/src/**/*.json' -o ./src/shared/i18n/diff.pot",
    "updatemessages:end": "rip po2json './src/shared/i18n/web.*.po' -m './i18n/src/**/*.json' -o ./src/shared/i18n/translation.json",
    "postupdatemessages:end": "fsys --task=remove --fileFolder=i18n && fsys --task=remove --fileFolder=src/shared/i18n/diff.pot",
    "lint": "eslint ./src --ext .js --ext .jsx",
    "clean": "fsys --task=emptyDir --dir=dist",
    "release:major": "npm version major && npm publish && git push --follow-tags",
    "release:minor": "npm version minor && npm publish && git push --follow-tags",
    "release:patch": "npm version patch && npm publish && git push --follow-tags"
  },
  "repository": "",
  "keywords": [],
  "author": "SystemOne",
  "devDependencies": {
    "babel-cli": "^6.24.1",
    "babel-core": "^6.24.1",
    "babel-eslint": "^7.2.2",
    "babel-loader": "^7.0.0-beta.1",
    "babel-plugin-lodash": "^3.2.11",
    "babel-plugin-react-intl": "^2.3.1",
    "babel-polyfill": "^6.23.0",
    "babel-preset-env": "^1.4.0",
    "babel-preset-es2015": "^6.24.1",
    "babel-preset-react": "^6.24.1",
    "babel-preset-stage-1": "^6.24.1",
    "babel-register": "^6.24.1",
    "case-sensitive-paths-webpack-plugin": "^2.0.0",
    "chunk-manifest-webpack-plugin": "^1.0.0",
    "core-js": "^2.4.0",
    "cross-env": "^4.0.0",
    "css-loader": "^0.28.0",
    "enzyme": "^2.8.2",
    "eslint": "^3.19.0",
    "eslint-config-airbnb": "^14.1.0",
    "eslint-loader": "^1.7.1",
    "eslint-plugin-import": "^2.2.0",
    "eslint-plugin-jsx-a11y": "^4.0.0",
    "eslint-plugin-react": "^6.10.3",
    "file-loader": "^0.11.1",
    "fs-extra-cli": "0.0.4",
    "glob": "^7.0.5",
    "html-webpack-plugin": "^2.28.0",
    "html-webpack-plugin-remove": "^0.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^19.0.2",
    "jest-bamboo-formatter": "^1.0.1",
    "node-sass": "^4.5.2",
    "npm-run-all": "^4.0.2",
    "null-loader": "^0.1.1",
    "postcss": "^5.2.17",
    "postcss-loader": "^1.3.3",
    "postcss-pxtorem": "^4.0.0",
    "react-addons-test-utils": "^15.4.2",
    "react-hot-loader": "^3.0.0-beta.4",
    "react-intl-po": "^2.0.2",
    "react-test-renderer": "^15.4.2",
    "sass-loader": "^6.0.3",
    "sinon": "^2.1.0",
    "static-loader": "^0.1.8",
    "style-loader": "^0.16.1",
    "url-loader": "^0.5.8",
    "webpack": "^2.4.1",
    "webpack-dev-server": "^2.4.2",
    "webpack-manifest-plugin": "^1.0.1"
  },
  "dependencies": {
    "classnames": "^2.2.5",
    "date-fns": "^1.28.3",
    "dom-helpers": "^3.2.1",
    "email-validator": "^1.0.7",
    "global": "^4.3.2",
    "http-client": "^4.3.1",
    "immutable": "^3.8.1",
    "intl": "^1.2.4",
    "invariant": "^2.2.2",
    "is-promise": "^2.1.0",
    "jwt-decode": "^2.2.0",
    "keycode": "^2.1.8",
    "lodash": "^4.17.4",
    "material-ui": "^0.16.7",
    "piwik-react-router": "^0.7.1",
    "raven-js": "^3.14.2",
    "react": "^15.4.2",
    "react-display-name": "^0.2.0",
    "react-dom": "^15.4.2",
    "react-google-maps": "^6.0.1",
    "react-helmet": "^4.0.0",
    "react-intl": "^2.2.3",
    "react-redux": "^5.0.4",
    "react-router": "^3.0.5",
    "react-router-scroll": "^0.4.2",
    "react-sparklines": "^1.5.2",
    "react-tap-event-plugin": "^2.0.1",
    "recompose": "^0.22.0",
    "redux": "^3.5.2",
    "redux-form": "^6.6.3",
    "redux-idle-monitor": "^0.6.2",
    "redux-immutable": "^4.0.0",
    "redux-thunk": "^2.2.0",
    "whatwg-fetch": "^2.0.3"
  }
}
