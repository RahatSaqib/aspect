{
  "name": "aspect-web",
  "private": true,
  "version": "0.0.1",
  "description": "The web client for the aspect API",
  "main": "",
  "scripts": {
    "start": "node server.js --env=dev",
    "mocha": "mocha --opts mocha_unit.opts",
    "run:tests:coverage": "istanbul cover --config istanbul.yml node_modules/mocha/bin/_mocha -- --opts mocha_unit.opts",
    "check:coverage": "istanbul check-coverage --config istanbul.yml",
    "pretest": "rimraf ./coverage",
    "test": "npm-run-all run:tests:coverage check:coverage",
    "test:watch": "npm run mocha -- --watch",
    "posttest": "npm run lint",
    "serve": "node server.js --env=dev",
    "serve:dist": "node server.js --env=dist",
    "dist": "npm run copy & webpack --env=dist",
    "lint": "eslint ./src",
    "copy": "copyfiles -f ./src/favicon.ico ./dist",
    "clean": "rimraf dist/*",
    "release:major": "npm version major && npm publish && git push --follow-tags",
    "release:minor": "npm version minor && npm publish && git push --follow-tags",
    "release:patch": "npm version patch && npm publish && git push --follow-tags"
  },
  "repository": "",
  "keywords": [],
  "author": "SystemOne",
  "devDependencies": {
    "babel-core": "^6.13.0",
    "babel-eslint": "^6.1.0",
    "babel-loader": "^6.2.0",
    "babel-plugin-webpack-alias": "^1.8.2",
    "babel-polyfill": "^6.13.0",
    "babel-preset-es2015": "^6.13.0",
    "babel-preset-react": "^6.11.0",
    "babel-preset-stage-1": "^6.13.0",
    "babel-register": "^6.14.0",
    "bower-webpack-plugin": "^0.1.9",
    "chai": "^3.2.0",
    "chai-immutable": "^1.6.0",
    "chunk-manifest-webpack-plugin": "^0.1.0",
    "copyfiles": "^1.0.0",
    "core-js": "^2.4.0",
    "css-loader": "^0.23.0",
    "enzyme": "^2.4.1",
    "eslint": "^3.3.0",
    "eslint-loader": "^1.5.0",
    "eslint-plugin-react": "^6.1.0",
    "file-loader": "^0.9.0",
    "glob": "^7.0.5",
    "html-webpack-plugin": "^2.22.0",
    "html-webpack-plugin-remove": "0.0.2",
    "isparta-instrumenter-loader": "^1.0.1",
    "istanbul": "^1.0.0-alpha.2",
    "jsdom": "^9.4.0",
    "minimist": "^1.2.0",
    "mocha": "^3.0.0",
    "npm-run-all": "^3.0.0",
    "null-loader": "^0.1.1",
    "open": "0.0.5",
    "postcss": "^5.1.0",
    "postcss-loader": "^0.10.0",
    "react-addons-test-utils": "^15.1.0",
    "react-hot-loader": "^1.2.9",
    "rimraf": "^2.4.3",
    "style-loader": "^0.13.0",
    "url-loader": "^0.5.6",
    "webpack": "^1.13.0",
    "webpack-dev-server": "^1.12.0",
    "webpack-manifest-plugin": "^1.0.1"
  },
  "dependencies": {
    "es6-promise": "^3.2.1",
    "immutable": "^3.8.1",
    "isomorphic-fetch": "^2.2.1",
    "jwt-decode": "^2.0.1",
    "material-ui": "^0.15.0",
    "moment": "^2.13.0",
    "react": "^15.3.0",
    "react-addons-pure-render-mixin": "^15.3.0",
    "react-dom": "^15.3.0",
    "react-helmet": "^3.1.0",
    "react-redux": "^4.4.5",
    "react-router": "^2.7.0",
    "react-router-redux": "^4.0.5",
    "react-router-scroll": "^0.3.0",
    "react-sparklines": "^1.5.2",
    "react-tap-event-plugin": "^1.0.0",
    "redux": "^3.5.2",
    "redux-immutable": "^3.0.0",
    "redux-thunk": "^2.1.0",
    "whatwg-fetch": "^1.0.0"
  }
}
