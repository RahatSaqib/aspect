{
  "name": "aspect",
  "private": true,
  "version": "1.0.0",
  "main": "index.js",
  "repository": "git@github.com:SystemOneId/aspect.git",
  "devDependencies": {
    "@formatjs/cli": "4.2.29",
    "concurrently": "^8.2.2",
    "eslint": "^8.39.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "formatjs": "^0.1.1",
    "husky": "8.0.3",
    "lint-staged": "13.1.2",
    "lodash": "^4.17.21",
    "make-runnable": "^1.4.1",
    "prettier": "^3.9.10"
  },
  "scripts": {
    "prepare": "husky install",
    "start": "concurrently \"yarn start:api\" \"yarn start:web\"",
    "start:api": "yarn --cwd ./api start",
    "start:api:fresh": "yarn --cwd ./api start:fresh",
    "start:web": "yarn --cwd ./web start",
    "start:web:fresh": "yarn --cwd ./web start:fresh",
    "actions:api": "yarn --cwd ./api install:ci",
    "actions": "yarn actions:api",
    "start:api:install": "yarn --cwd ./api install",
    "start:api:seed": "yarn --cwd ./api db:reseedCI",
    "start:api:bg": "yarn --cwd ./api start:background",
    "api:lint": "yarn --cwd ./api lint",
    "api:contract": "concurrently -k -s first -P 'yarn --cwd ./api start:ci' 'sleep 10 && yarn --cwd ./api mocha:contract:ci {@}' --",
    "api:unit": "yarn --cwd ./api test:unit:ci",
    "stop:api:bg": "yarn --cwd ./api stop:background",
    "start:web:install": "yarn --cwd ./web install",
    "start:web:server": "yarn --cwd ./web start:ci",
    "web:test": "yarn --cwd ./web test:ci",
    "web:lint": "yarn --cwd ./web lint",
    "act": "act pull_request -P ubuntu-latest=node:14"
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
