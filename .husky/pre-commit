#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

local_branch_name="$(git rev-parse --abbrev-ref HEAD)"

valid_branch_regex='^((fix|feat|feature|no-ticket)\/[a-zA-Z0-9\-]{0,35})$'

message="Branch name failed. Branch names in should match (fix|feat|feature|no-ticket)/branch-name  and should not be longer than 35 chars."

if [[ ! $local_branch_name =~ $valid_branch_regex ]]; then
    echo "$message"
    exit 1
fi


./node_modules/.bin/lint-staged -c ./web/.lintstagedrc --allow-empty
./node_modules/.bin/lint-staged -c ./api/.lintstagedrc --allow-empty

exit 0
