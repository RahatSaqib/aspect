#!/bin/sh
regex="fix|feat|poc|no-ticket"
local_branch_name="$(git rev-parse --abbrev-ref HEAD)"
valid_branch_regex="^(($regex)\/[a-zA-Z0-9\-]{0,75})$"
message="Branch name '$local_branch_name' should match ($regex)/(branch-kebab-case-name) and not be longer than 75 chars."

if [[ $local_branch_name =~ "dependabot" ]]; then
    echo "Branch name '$local_branch_name' is dependabot related, skipping ✅"
    exit 0
fi

if [[ ! $local_branch_name =~ $valid_branch_regex ]]; then
    echo "$local_branch_name fails linting ❌"
    echo "$message"
    echo "For renaming the current branch please use"
    echo "git branch -m <newname>"
    exit 1
fi

echo "Branch name '$local_branch_name' is valid ✅"
exit 0
