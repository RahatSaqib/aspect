secret=Any_Random_String

passwordAttempts=5
passwordSaltRounds=10

db.connectionLimit=100
db.host=localhost
db.user=aspectapi
db.password=your_local_database_password
db.databaseName=aspect
db.debug=false

# Optional logstash configuration
# Will log to console if not configured
# logstash.endpoint=tcp://localhost:5000
# logstash.endpoint=udp://localhost:9001

# Optional Raven (Sentry) configuration
# raven.dsn=https://...

# Optional knex seed directory
# seeds.directory='./seeds/development'
