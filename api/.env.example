secret=Any_Random_String

passwordAttempts=5
passwordSaltRounds=10

gxAlertApi=http://dev.gxalert.com/api

db.connectionLimit=100
db.host=localhost
db.user=aspectapi
db.password=mypassword
db.databaseName=aspect
db.debug=false

# Path to files generated from FileReference (webhooks, reports, etc)
file.reference.directory='./files'

amqp.url=amqp://localhost
# Optional default name aspect
# amqp.name='aspect'

# Optional logging settings
# log.db.enabled=true # Default false

# Optional Raven (Sentry) configuration
# raven.dsn=https://...

# Optional knex seed directory
seeds.directory='./seeds/development'

# Optional result multiplier - determines number of generated dummy results
# seeds.resultMultiplier=1000

# optional email/sms for seeding admin account
admin.email = aspecttest@systemone.id
admin.cell = ''

aspectUrl=http://dev.aspect.id

# hapi-swagger
