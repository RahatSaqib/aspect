# Logging Features
# By default, the logging level is set to INFO & written to the console (/var/log/syslog in production environments).
# The following log settings allow default behavior to be changed.
# All log parameters are optional

# labelsWhiteList:(RegEx, default Empty) Only logs that have labels that match this regular expression will be written to the console. This allows us to zero in on specific labels so that the process that we are trying to observe is not polluted by other concurrent logs.
# Example: Only write logs for results that come in from the deviceAPI, issues and message queue events. This would help to monitor:
# - a result that is created in Aspect
# - messages that are queued at the time the result was created
# - issues being triggered at the time the result was created
# - notifications being sent at the time the result was created
# - issues being resolved at the time the result was created
# log.console.labelsWhiteList = 'aspect:mq|deviceApi|issues'

# labelsBlackList:(RegEx, default Empty) similar to labelsWhiteList except all logs that contain labels matching this regular expression will be excluded from the console log.
# log.console.labelsBlackList = 'evaluatePluginFunction|actionConditionsMet'

# log level for the console output (Default info)
# possible values (in order of severity): emerg, alert, crit, error, warning, notice, info, debug
# log.console.logLevel = 'debug'

# format: the output format (default is text)
# Winston uses logform to format logs. For a full list of options, refer to https://github.com/winstonjs/logform#readme
# log.console.format='JSON'

# File Log Options
# The following options apply the same behavior as the standard log options but to an additional file log that can be written to a specified directory
# The default location for a file log is at ~/api/
# log.file.path = 'logFile.log'
# log.file.logLevel = 'error'
# log.file.labelsBlackList = 'issue|Aspect|mq:'
# log.file.labelsWhiteList = 'evaluatePluginFunction|actionConditionsMet'
# log.file.format='JSON'

# Email "Log" Options
# log.mail.logLevel = 'alert'

