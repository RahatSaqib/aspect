{
  "parserOptions": {
    "ecmaVersion": 2016,
    "sourceType": "module"
  },
  "env": {
    "amd": true,
    "es6": true,
    "node": true,
    "mocha": true
  },
  "extends": [
    "airbnb",
    "prettier",
    "prettier/flowtype"
  ],
  "plugins": [
    "prettier",
    "jsx-a11y"
  ],
  "rules": {
    "semi": [
      "warn",
      "never"
    ],
    "comma-dangle": "off",
    "func-names": "off",
    "global-require": "off",
    "linebreak-style": "off",
    "newline-per-chained-call": "off",
    "no-confusing-arrow": ["error", {"allowParens": true}],
    "no-iterator": "off",
    "no-nested-ternary": "off",
    "no-param-reassign": "off",
    "no-plusplus": ["error", { "allowForLoopAfterthoughts": true }],
    "no-restricted-syntax": "off",
    "no-shadow": "off",
    "no-use-before-define": "off",
    "prettier/prettier": ["error", {
      "semi": false,
      "singleQuote": true,
      "trailingComma": "es5"
    }],
    "require-yield": "off"
  }
}
