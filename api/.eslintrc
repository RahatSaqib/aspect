{
  "parserOptions": {
    "ecmaVersion": 6,
    "sourceType": "module"
  },
  "env": {
    "amd": true,
    "es6": true,
    "node": true,
    "mocha": true
  },
  "extends": "airbnb",
  "rules": {
    "semi": [
      "warn",
      "never"
    ],
    "comma-dangle": "off",
    "global-require": "off",
    "newline-per-chained-call": "off",
    "no-iterator": "off",
    "no-use-before-define": "off"
  }
}
