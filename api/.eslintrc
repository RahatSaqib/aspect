{
  "parserOptions": {
    "ecmaVersion": 6,
    "sourceType": "module"
  },
  "env": {
    "amd": true,
    "es6": true,
    "node": true,
    "mocha": true
  },
  "rules": {
    "indent": [
      "warn",
      2
    ],
    "comma-dangle": 1,
    "quotes": [
      1,
      "single"
    ],
    "no-var": 1,
    "no-undef": 1,
    "global-strict": 0,
    "no-extra-semi": 1,
    "no-underscore-dangle": 0,
    "no-unused-vars": 1,
    "no-trailing-spaces": [
      1,
      {
        "skipBlankLines": true
      }
    ],
    "no-unreachable": 1,
    "semi": ["warn", "never"]
  }
}
