{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "http://aspect.id/resultForm.json",
    "type": "object",
    "readOnly": true,
    "title": "Schema for the result form",
    "description": "This is the schema for adding custom fields related to the clinical response",
    "required": [
        "fields"
    ],
    "properties": {
        "refForms":{
            "$id": "#/properties/refForms",
            "type": "array",
            "minItems": 0,
            "title": "The list of externalId from others forms, that this form need to render.",
            "description": "the idea is to reference other forms, when you need other forms data for rendering the field with some condition. This is going to be used just for check if the forms referenced are present in the complete JSON object",
            "default": []
        },
        "fields": {
            "$id": "#/properties/fields",
            "type": "array",
            "minItems": 1,
            "title": "The list of form Fields",
            "description": "The list of form Fields for filling the clinical response",
            "additionalItems": true,
            "items": {
                "$id": "#/properties/fields/items",
                "type": "object",
                "readOnly": true,
                "title": "Field metadata",
                "description": "All the properties needed for this field to be rendered",
                "required": [
                    "name",
                    "i18nKey",
                    "fieldType",
                    "order"
                ],
                "properties": {
                    "name": {
                        "$id": "#/properties/fields/items/properties/name",
                        "type": "string",
                        "title": "Field name",
                        "description": "The name of the field"
                        
                    },
                    "caption": {
                        "$id": "#/properties/fields/items/properties/caption",
                        "type": "string",
                        "title": "capation text",
                        "description": "The caption/help text of the field"
                        
                    },
                    "i18nKey": {
                        "$id": "#/properties/fields/items/properties/i18nKey",
                        "type": "string",
                        "title": "The i18nkey",
                        "description": "i18nkey key"
                    },
                    "i18nKeyCaption":{
                        "$id": "#/properties/fields/items/properties/i18nKeyCaption",
                        "type": "string",
                        "title": "The i18nkey of the caption text",
                        "description": "i18nkey key of the caption text"
                    },
                    "fieldType": {
                        "$id": "#/properties/fields/items/properties/fieldType",
                        "type": "string",
                        "title": "Field type",
                        "description": "Type of the data to be stored",
						"enum":["text", "integer", "date", "decimal", "binary", "boolean", "list"]
                    },
                    "order": {
                        "$id": "#/properties/fields/items/properties/order",
                        "type": "integer",
                        "title": "Field Order ",
                        "description": "The order of appearence of the form field",
                        "default": 0,
						"minimum":0
                    },
                    "controlType": {
                        "$id": "#/properties/fields/items/properties/controlType",
                        "type": "string",
                        "title": "The Controltype Schema",
                        "description": "An explanation about the purpose of this instance.",
                        "default": "",
    					"enum": ["textBox", "comboBox", "textArea", "radioButton", "checkBox", "list", "autoComplete","datePicker", "filePicker", "camera"]                    
                    },
                    "required": {
                        "$id": "#/properties/fields/items/properties/required",
                        "type": "boolean",
                        "title": "Field is required",
                        "description": "An explanation about the purpose of this instance.",
                        "default": false                    },
                    "encrypted": {
                        "$id": "#/properties/fields/items/properties/encrypted",
                        "type": "boolean",
                        "title": "Encrypted Field",
                        "description": "This property is true if the field value is encrypted",
                        "default": false
                    },
                    "validation": {
                        "$id": "#/properties/fields/items/properties/validation",
                        "title": "validation field method",
                        "description": "A how to validate the field value",
                        "type": "array",
                        "minItems":0,
                        "default": [],
                        "items": {
                            "$id": "#/properties/fields/items/properties/validation/items",
                            "type": "object",
                            "title": "The validation conditions",
                            "description": "The rules of validations that should be addressed",
                            "required": [
                                "validationType"
                            ],
                            "properties": {
                                "validationType": {
                                    "$id": "#/properties/fields/items/properties/validation/items/validatinType",
                                    "type": "string",
                                    "title": "The type of the validation",
                                    "description": "This property is for defying the type of the validation we are going to perform",
                                    "default": "regex",
                                    "enum":["regex","float","integer", "datetime"]
                                },
                                "regex": {
                                    "$id": "#/properties/fields/items/properties/validation/items/regex",
                                    "type": "string",
                                    "title": "Regular Expression to validate",
                                    "description": "The regular expression to be matched",
                                    "dependencies": {
                                        "validationType": { "required": ["regex"] }
                                    }
                                },
                                "min": {
                                    "$id": "#/properties/fields/items/properties/validation/items/minimun",
                                    "type": "integer",
                                    "title": "the minumun value",
                                    "description": "The minimun value of the field",
                                    "dependencies": {
                                        "validationType": { "required": ["integer", "float"] }
                                    }
                                },
                                "max": {
                                    "$id": "#/properties/fields/items/properties/validation/items/minimun",
                                    "type": "integer",
                                    "title": "the maximun value",
                                    "description": "The maximun value for the number field",
                                    "dependencies": {
                                        "validationType": { "required": ["integer", "float"] }
                                    }
                                },
                                "errorMessage":{
                                    "$id": "#/properties/fields/items/properties/validation/items/errorMessage",
                                    "type": "string",
                                    "title": "the error message",
                                    "description": "The error message when validation fails"
                                },
                                "errorMessageI18n":{
                                    "$id": "#/properties/fields/items/properties/validation/items/errorMessageI18n",
                                    "type": "string",
                                    "title": "the error message",
                                    "description": "The error message when validation fails i18nkey"
                                }
                            }
                        }
                    },
                    "condition": {
                        "$id": "#/properties/fields/items/properties/condition",
                        "type": "array",
                        "title": "Condition for field visibility",
                        "minItems":0,
                        "description": "these are the conditions for rendering the specific field",
                        "default": [],
                        "items": {
                            "$id": "#/properties/fields/items/properties/condition/items",
                            "type": "object",
                            "title": "The condition preposition",
                            "description": "One part of the condition preposition",
                            "examples": [
                                {
                                    "conjunction": "AND",
                                    "propToCompare": "propName",
                                    "valueToCompare": "value",
                                    "operator": "=",
                                    "conjunctionGroupName":"groupName"
                                }
                            ],
                            "required": [
                                "operator"
                            ],
                            "properties": {
                                "propToCompare": {
                                    "$id": "#/properties/fields/items/properties/condition/items/properties/propToCompare",
                                    "type": "string",
                                    "title": "The name of the property for comparing the value",
                                    "description": "We are going to use this as a key for obtaining the property value for compearing the condition",
                                    "default": "",
                                    "examples": [
                                        "propName"
                                    ]
                                },
                                "operator": {
                                    "$id": "#/properties/fields/items/properties/condition/items/properties/operator",
                                    "type": "string",
                                    "title": "The Operator Schema",
                                    "description": "An explanation about the purpose of this instance.",
                                    "default": "=",
                                    "enum": [
                                        "=", "!=",">=","<="
                                    ]
                                },
                                "fieldToCompare": {
                                    "$id": "#/properties/fields/items/properties/condition/items/properties/fieldToCompare",
                                    "type": "string",
                                    "title": "The field name to compare",
                                    "description": "The name of the field into the tableNameToCompare table for doing the comparission",
                                    "examples": [
                                        "fieldName"
                                    ]
                                },
                                "tableNameToCompare": {
                                    "$id": "#/properties/fields/items/properties/condition/items/properties/tableNameToCompare",
                                    "type": "string",
                                    "title": "The Table for field comparing",
                                    "description": "The name of the table where the field to compare with is placed",
                                    "examples": [
                                        "tableName"
                                    ]
                                },
                                "valueToCompare": {
                                    "$id": "#/properties/fields/items/properties/condition/items/properties/valueToCompare",
                                    "type": "string",
                                    "title": "The value of the property to be compared",
                                    "description": "this is the right side of the condition value",
                                    "examples": [
                                        "value"
                                    ]
                                },
                                "conjunction": {
                                    "$id": "#/properties/fields/items/properties/condition/items/properties/conjunction",
                                    "type": "string",
                                    "title": "The Conjunction operator between prepositions",
                                    "description": "The Conjunction operator between prepositions",
                                    "default": "AND",
                                    "enum": [
                                        "AND", "OR"
                                    ]
                                },
                                "conjunctionGroup": {
                                    "$id": "#/properties/fields/items/properties/condition/items/properties/conjunction",
                                    "type": "string",
                                    "title": "Conjuction Group",
                                    "description": "Under the same group all the prepositions they are going to be enclosed by ()"
                                }
                            },
                            "oneOf": [
                                {
                                    "required": [
                                        "valueToCompare", "propToCompare"
                                    ]
                                },
                                {
                                    "required": [
                                        "tableNameToCompare","fieldToCompare"
                                    ]
                                }
                            ]
                        }
                    },
                    "resultDbColumn": {
                        "$id": "#/properties/fields/items/properties/resultDbColumn",
                        "type": "string",
                        "title": "Mapped result field",
                        "description": "The name of an existing field into the result table"
                    },
                    "sampleDbColumn": {
                        "$id": "#/properties/fields/items/properties/sampleDbColumn",
                        "type": "string",
                        "title": "Mapped sample field",
                        "description": "The name of an existing field into the sample table"
                    },
                    "caseDbColumn": {
                        "$id": "#/properties/fields/items/properties/caseDbColumn",
                        "type": "string",
                        "title": "Mapped case field",
                        "description": "The name of an existing field into the sample table"
                    },
                    "optionSource": {
                        "$id": "#/properties/fields/items/properties/optionSource",
                        "type": "string",
                        "title": "Url of an existing endpoint",
                        "description": "url for an existing endpoint (Aspect or thirdparty one) for filling a list",
                        "default": "https://demo.aspect.id/api",
                        "dependencies": {
                            "typeOfOptionSource": { "required": ["aspectUrl", "customUrl"] }
                        }
                    },
                    "typeOfOptionSource": {
                        "$id": "#/properties/fields/items/properties/typeOfOptionSource",
                        "type": "string",
                        "title": "The type of optionlist source",
                        "description": "The option list source could be a fixed list, and aspect URL or a third party url",
                        "default": "fixedList",
                        "enum": [
                            "aspectUrl", "customUrl",  "fixedList", "function"
                        ]
                    },
                    "optionValues": {
                        "$id": "#/properties/fields/items/properties/optionValues",
                        "type": "array",
                        "title": "The fixed list ",
                        "dependencies": {
                            "typeOfOptionSource": { "required": ["fixedList"] }
                        },
                        "minItems": 1,
                        "description": "This is the list of options to filled the dropdown list, checkbox/radio list or single lists",
                        "items": {
                            "$id": "#/properties/fields/items/properties/optionValues/items",
                            "type": "object",
                            "title": "The Option values Schema",
                            "description": "The option values objects",
                            "examples": [
                                {
                                    "key": "value",
                                    "value": "value"
                                }
                            ],
                            "required": [
                                "key",
                                "value"
                            ],
                            "properties": {
                                "key": {
                                    "$id": "#/properties/fields/items/properties/optionValues/items/properties/key",
                                    "type": "string",
                                    "readOnly": false,
                                    "writeOnly": false,
                                    "minLength": 0,
                                    "title": "The Key of the option",
                                    "description": "The Key of the option"
                                },
                                "value": {
                                    "$id": "#/properties/fields/items/properties/optionValues/items/properties/value",
                                    "type": "string",
                                    "title": "The Value of the option",
                                    "description": "The Value of the option"
                                }
                            }
                        }
                    },
                    "customUrlMappingFields": {
                        "$id": "#/properties/fields/items/properties/customUrlMappingFields",
                        "type": "object",
                        "title": "Mapping fields for option list",
                        "description": "Only for third party API option, This property is going to define which properties in the response object collection is going to be the key and the value for filling the different lists",
                        "dependencies": {
                            "typeOfOptionSource": { "required": ["customUrl", "function"] }
                        },
                        "examples": [
                            {
                                "key": "name property for the key field",
                                "value": "name property for the Value field"
                            }
                        ],
                        "required": [
                            "key",
                            "value"
                        ],
                        "properties": {
                            "key": {
                                "$id": "#/properties/fields/items/properties/customUrlMappingFields/properties/key",
                                "type": "string",
                                "title": "The Key option to be mapped",
                                "description": "This will be the name for looking for in the response for mapping into our option list structure",
                                "default": "",
                                "examples": [
                                    "name property for the key field"
                                ]
                            },
                            "value": {
                                "$id": "#/properties/fields/items/properties/customUrlMappingFields/properties/value",
                                "type": "string",
                                "title": "The Value option to be mapped",
                                "description": "This will be the key for looking for in the response for mapping into our option list structure"
                            }
                        }
                    },
                    "customUrlResponseType": {
                        "$id": "#/properties/fields/items/properties/customUrlResponseType",
                        "type": "string",
                        "title": "The response type of the custom url",
                        "description": "The response type of the custom url",
                        "enum": [
                            "json | xml"
                        ],
                        "dependencies": {
                            "typeOfOptionSource": { "required": ["customUrl"] }
                        }
                    },
                    "functionModule": {
                        "$id": "#/properties/fields/items/properties/functionModule",
                        "type": "string",
                        "title": "The module name for the function",
                        "description": "The module where the function is placed",
                        "dependencies": {
                            "typeOfOptionSource": { "required": ["function"] }
                        }

                    },
                    "functionName": {
                        "$id": "#/properties/fields/items/properties/functionName",
                        "type": "string",
                        "title": "The function name",
                        "description": "The function name which retrieves the option list",
                        "dependencies": {
                            "typeOfOptionSource": { "required": ["function"] }
                        }

                    }
                }
            }
        }
    }
}
