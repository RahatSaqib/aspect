{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "http://aspect.id/gxConnectCustomFieldsSchema.json",
  "type": "object",
  "readOnly": true,
  "title": "Schema for the GxConnect custom fields",
  "description": "This is the schema for the GxConnect custom fields returned with the daily status response",
  "required": ["CustomFields"],
  "properties": {
    "CustomFields": {
      "$id": "#/properties/CustomFields",
      "type": "object",
      "minItems": 0,
      "title": "The CustomFields object containing the array of fields.",
      "default": null,
      "required": ["Fields"],
      "properties": {
        "Fields": {
          "$id": "#/properties/CustomFields/Fields",
          "type": "array",
          "minItems": 0,
          "title": "The array of fields.",
          "default": null,
          "uniqueItemProperties": ["Id"]
        }
      }
    }
  }
}
