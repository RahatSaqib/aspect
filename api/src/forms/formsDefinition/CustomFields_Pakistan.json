      "payloadDestinationPath": "patient.PatientAge",
      "source": "patientData.PatientAge",
      "mandatory": false,
      "validation": [
        {
          "validationType": "regex",
          "value": "^[2-9]$|^[1-9][0-9]$|^1[0-4][0-9]$|^150$",
          "errorMessage": "Patient Age should be a number between 2 and 150. For lower age please use field Age in Months.",
          "errorMessageI18nKey": "PKPatientAgeValidationFieldi18nKey"
        }
      ],
      "condition": [
        {
          "propToCompare": "PKPatientAgeMonths",
          "valueToCompare": "",
          "operator": "=",
          "conjunction": "or"
        },
        {
          "propToCompare": "PKPatientAgeMonths",
          "valueToCompare": null,
          "operator": "=",
          "conjunction": "or"
        }
      ]
    },
