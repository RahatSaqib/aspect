{
  "name": "aspect-api",
  "private": true,
  "version": "0.0.1",
  "description": "The API for aspect clients",
  "main": "server.js",
  "scripts": {
    "knex": "knex",
    "lint": "eslint ./src ./test ./migrations ./seeds ./knexfile.js --ext .js",
    "mocha:contract": "mocha --opts test/contract.mocha.opts",
    "mocha:unit": "mocha --opts test/unit.mocha.opts",
    "mocha:unit:clear:coverage": "fsys --task=remove --fileFolder=coverage && fsys --task=remove --fileFolder=mocha.json",
    "mocha:unit:coverage": "nyc mocha --opts test/unit.mocha.opts",
    "poststop:background": "shx echo API LOGS: && shx echo ------------------------------------------------------------- && shx cat out.log && shx echo API ERRORS: && shx echo ------------------------------------------------------------- && shx cat err.log",
    "prestart:background": "fsys --task=remove --fileFolder=out.log && fsys --task=remove --fileFolder=err.log",
    "precommit": "lint-staged",
    "prettier": "prettier --no-semi --single-quote --trailing-comma=es5",
    "prettier:write": "npm run prettier -- --write \"{migrations,seeds,src,test}/**/*.js\"",
    "start": "nodemon src/server.js",
    "start:background": "forever start -o out.log -e err.log src/server.js",
    "start:background:quiet": "forever start src/server.js",
    "stop:background": "forever stop src/server.js",
    "stop:background:quiet": "forever stop src/server.js",
    "test": "npm-run-all test:unit test:contract",
    "test:quiet": "npm-run-all test:unit test:contract:quiet",
    "test:contract": "npm-run-all -c start:background mocha:contract stop:background",
    "test:contract:quiet": "npm-run-all -c start:background:quiet mocha:contract stop:background:quiet",
    "test:unit": "npm-run-all lint mocha:unit:clear:coverage mocha:unit:coverage"
  },
  "nyc": {
    "check-coverage": true,
    "per-file": true,
    "lines": 0,
    "statements": 0,
    "functions": 0,
    "branches": 0,
    "exclude": [
      "**/*.test.js",
      "**/*.test.jsx",
      "test/*"
    ],
    "reporter": [
      "lcov"
    ],
    "cache": false,
    "all": true,
    "report-dir": "./coverage"
  },
  "lint-staged": {
    "linters": {
      "api/src/**/*.js": [
        "eslint --fix",
        "git add"
      ],
      "api/test/**/*.js": [
        "eslint --fix",
        "git add"
      ],
      "api/migrations/**/*.js": [
        "eslint --fix",
        "git add"
      ],
      "api/seeds/**/*.js": [
        "eslint --fix",
        "git add"
      ]
    }
  },
  "author": "SystemOne",
  "license": "ISC",
  "dependencies": {
    "amqplib": "^0.5.2",
    "babel-eslint": "^7.2.2",
    "base32": "^0.0.6",
    "bcrypt": "^1.0.3",
    "boom": "^5.2.0",
    "date-fns": "^1.28.5",
    "debug": "^3.1.0",
    "dotenv-safe": "^4.0.4",
    "email-templates": "^2.7.1",
    "exceljs": "^0.5.1",
    "fs-extra": "^6.0.1",
    "good": "^7.2.0",
    "good-console": "^6.4.0",
    "good-logstash": "^2.0.2",
    "good-squeeze": "^5.0.2",
    "handlebars": "^4.0.11",
    "hapi": "^16.5.2",
    "hapi-auth-basic": "^4.2.0",
    "hapi-auth-jwt2": "^7.3.0",
    "hapi-raven": "^6.0.0",
    "hapi-swagger": "^7.7.1",
    "http-client": "^4.3.1",
    "inert": "^4.2.1",
    "isomorphic-fetch": "^2.2.1",
    "joi": "^10.6.0",
    "json2csv": "^3.11.1",
    "jsonwebtoken": "^7.4.3",
    "knex": "^0.14.6",
    "lodash": "^4.17.4",
    "mysql": "^2.14.1",
    "node-base64-image": "^1.0.4",
    "node-cron": "^1.2.1",
    "node-uuid": "^1.4.8",
    "raven": "^2.1.2",
    "sendgrid": "^5.2.2",
    "shx": "^0.2.2",
    "twilio": "^3.13.1",
    "vision": "^4.1.1"
  },
  "devDependencies": {
    "chai": "^4.1.1",
    "chai-subset": "^1.6.0",
    "eslint": "^4.5.0",
    "eslint-config-airbnb": "^16.1.0",
    "eslint-config-prettier": "^2.3.0",
    "eslint-plugin-import": "^2.7.0",
    "eslint-plugin-jsx-a11y": "^6.0.2",
    "eslint-plugin-prettier": "^2.2.0",
    "eslint-plugin-react": "^7.3.0",
    "forever": "^0.15.3",
    "fs-extra-cli": "^0.0.4",
    "husky": "^0.14.3",
    "lint-staged": "^6.0.0",
    "mocha": "^3.5.0",
    "mocha-bamboo-reporter": "^1.1.1",
    "mocha-multi": "^0.11.0",
    "nodemon": "^1.11.0",
    "npm-run-all": "^4.0.2",
    "nyc": "^11.4.1",
    "prettier": "^1.5.3",
    "proxyquire": "^1.8.0",
    "shx": "^0.2.2",
    "sinon": "^3.2.1",
    "supertest": "^3.0.0"
  }
}
