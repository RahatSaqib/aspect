{
  "name": "aspect-api",
  "private": true,
  "version": "0.9.1",
  "description": "The API for aspect clients",
  "main": "server.js",
  "engines": {
    "node": "14"
  },
  "scripts": {
    "db:recreate": "node ./migrations/utils/recreateDB",
    "db:recreateCI": "node ./migrations/utils/recreateDBCI",
    "db:reseed": "npm-run-all db:recreate knex:migrate:latest knex:seed:run",
    "db:reseedCI": "npm-run-all db:recreateCI knex:migrate:latest knex:seed:run",
    "debug": "nodemon --inspect src/server.js",
    "knex": "knex",
    "knex:migrate:latest": "knex migrate:latest",
    "knex:seed:run": "knex seed:run",
    "lint": "eslint ./src ./test ./migrations ./seeds ./knexfile.js --ext .js",
    "mocha:contract": "TZ=UTC mocha --config test/contract.mocharc.js ",
    "mocha:contract:ci": "TZ=UTC mocha --config test/contract.mocharc.js",
    "mocha:unit": "TZ=UTC mocha --config test/unit.mocharc.js",
    "mocha:unit:clear:coverage": "fsys --task=remove --fileFolder=coverage && fsys --task=remove --fileFolder=mocha.json",
    "mocha:unit:coverage": "nyc mocha --config test/unit.mocharc.js",
    "poststop:background": "shx echo API LOGS: && shx echo ------------------------------------------------------------- && shx cat out.log && shx echo API ERRORS: && shx echo ------------------------------------------------------------- && shx cat err.log",
    "prestart:background": "fsys --task=remove --fileFolder=out.log && fsys --task=remove --fileFolder=err.log",
    "prettier": "prettier --no-semi --single-quote --trailing-comma=es5",
    "prettier:write": "eslint ./src ./test ./migrations ./seeds ./knexfile.js --ext .js --fix",
    "start": "nodemon src/server.js",
    "start:background:pm2": "yarn && pm2 start src/server.js",
    "start:background": "forever start -o out.log -e err.log src/server.js",
    "start:background:quiet": "forever start src/server.js",
    "start:fresh": "yarn && yarn db:reseed && yarn start",
    "start:ci": "yarn && yarn db:reseed",
    "stop:background:pm2": "pm2 stop src/server.js",
    "stop:background": "forever stop src/server.js",
    "stop:background:quiet": "forever stop src/server.js",
    "test": "npm-run-all test:json test:unit test:contract",
    "test:json": "ajv test -s jsonSchemas/dynamicFormSchema.json -d 'src/forms/formsDefinition/*.json' --valid",
    "test:quiet": "npm-run-all test:unit test:contract:quiet",
    "test:contract": "TZ=UTC npm-run-all -c start:background mocha:contract stop:background",
    "test:contract:quiet": "TZ=UTC npm-run-all -c start:background:quiet mocha:contract stop:background:quiet",
    "test:unit": "TZ=UTC npm-run-all lint mocha:unit:clear:coverage mocha:unit:coverage",
    "test:unit:ci": "TZ=UTC npm-run-all mocha:unit:clear:coverage mocha:unit:coverage",
    "test:reseed": "npm-run-all db:reseed test"
  },
  "nyc": {
    "check-coverage": true,
    "per-file": true,
    "lines": 0,
    "statements": 0,
    "functions": 0,
    "branches": 0,
    "exclude": [
      "**/*.test.js",
      "**/*.test.jsx",
      "test/*"
    ],
    "reporter": [
      "lcov"
    ],
    "cache": false,
    "all": true,
    "report-dir": "./coverage"
  },
  "author": "SystemOne",
  "license": "ISC",
  "dependencies": {
    "@hapi/basic": "^6.0.0",
    "@hapi/boom": "^9.1.4",
    "@hapi/hapi": "^20.2.1",
    "@hapi/inert": "^6.0.5",
    "@hapi/joi": "^17.1.1",
    "@hapi/vision": "^6.1.0",
    "@sentry/node": "^6.19.1",
    "@sentry/tracing": "^6.19.1",
    "ajv": "^8.11.0",
    "ajv-cli": "^5.0.0",
    "ajv-keywords": "^5.1.0",
    "amqplib": "^0.8.0",
    "base32": "^0.0.6",
    "bcrypt": "5.0.1",
    "bluebird": "^3.7.2",
    "date-fns": "^2.28.0",
    "date-fns-timezone": "^0.1.4",
    "debug": "^4.3.4",
    "deep-equal-in-any-order": "^1.1.15",
    "dotenv-safe": "^8.2.0",
    "email-templates": "9.0.0",
    "exceljs": "^4.3.0",
    "firebase-admin": "^10.0.2",
    "flat": "^5.0.2",
    "fs-extra": "^10.0.1",
    "google-libphonenumber": "^3.2.27",
    "handlebars": "^4.7.7",
    "hapi-auth-jwt2": "^10.2.0",
    "hapi-raven": "^7.0.1",
    "hapi-sentry": "^3.2.0",
    "hapi-swagger": "^14.2.5",
    "http-client": "^4.3.1",
    "isomorphic-fetch": "^3.0.0",
    "json2csv": "^5.0.7",
    "jsonwebtoken": "^8.5.1",
    "knex": "^1.0.4",
    "lodash": "^4.17.21",
    "mysql": "^2.18.1",
    "node-base64-image": "^2.0.4",
    "node-cron": "^3.0.0",
    "node-uuid": "^1.4.8",
    "nodemailer": "^6.7.3",
    "object-mapper": "^6.2.0",
    "phone": "^3.1.14",
    "pug": "^3.0.2",
    "raven": "^2.6.4",
    "shx": "^0.3.4",
    "timezone-support": "^2.0.2",
    "twilio": "^3.75.1",
    "vision": "^5.4.4",
    "winston": "^3.6.0",
    "winston-mail": "^2.0.0",
    "winston-sentry-log": "^1.0.24"
  },
  "devDependencies": {
    "@babel/core": "^7.17.8",
    "@babel/eslint-parser": "^7.17.0",
    "chai": "^4.3.6",
    "chai-as-promised": "^7.1.1",
    "chai-subset": "^1.6.0",
    "chromedriver": "^99.0.0",
    "eslint": "^8.11.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-no-only-tests": "^2.6.0",
    "eslint-plugin-prettier": "^4.0.0",
    "forever": "^4.0.3",
    "fs-extra-cli": "^0.0.4",
    "jwt-decode": "^3.1.2",
    "mocha": "^9.2.2",
    "mocha-bamboo-reporter": "^1.1.2",
    "mocha-json-output-reporter": "^2.0.1",
    "mocha-multi": "^1.1.6",
    "nodemon": "^2.0.15",
    "npm-run-all": "^4.1.5",
    "nyc": "^15.1.0",
    "pm2": "^5.2.0",
    "prettier": "^2.6.0",
    "proxyquire": "^2.1.3",
    "shx": "^0.3.4",
    "sinon": "^13.0.1",
    "supertest": "^6.2.2"
  }
}
