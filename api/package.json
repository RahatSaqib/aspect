{
  "name": "aspect-api",
  "private": true,
  "version": "0.9.1",
  "description": "The API for aspect clients",
  "main": "server.js",
  "scripts": {
    "db:recreate": "node ./migrations/utils/recreateDB",
    "db:reseed": "npm-run-all db:recreate knex:migrate:latest knex:seed:run",
    "debug": "nodemon --inspect src/server.js",
    "knex": "knex",
    "knex:migrate:latest": "knex migrate:latest",
    "knex:seed:run": "knex seed:run",
    "lint": "eslint ./src ./test ./migrations ./seeds ./knexfile.js --ext .js",
    "mocha:contract": "mocha --config test/contract.mocharc.js",
    "mocha:unit": "mocha  --config test/unit.mocharc.js",
    "mocha:unit:clear:coverage": "fsys --task=remove --fileFolder=coverage && fsys --task=remove --fileFolder=mocha.json",
    "mocha:unit:coverage": "nyc mocha --config test/unit.mocharc.js",
    "poststop:background": "shx echo API LOGS: && shx echo ------------------------------------------------------------- && shx cat out.log && shx echo API ERRORS: && shx echo ------------------------------------------------------------- && shx cat err.log",
    "prestart:background": "fsys --task=remove --fileFolder=out.log && fsys --task=remove --fileFolder=err.log",
    "prettier": "prettier --no-semi --single-quote --trailing-comma=es5",
    "prettier:write": "eslint ./src ./test ./migrations ./seeds ./knexfile.js --ext .js --fix",
    "start": "nodemon src/server.js",
    "start:background": "forever start -o out.log -e err.log src/server.js",
    "start:background:quiet": "forever start src/server.js",
    "start:fresh": "yarn && yarn db:reseed && yarn start",
    "stop:background": "forever stop src/server.js",
    "stop:background:quiet": "forever stop src/server.js",
    "test": "npm-run-all test:json test:unit test:contract",
    "test:json": "ajv test -s jsonSchemas/dynamicFormSchema.json -d 'src/forms/formsDefinition/*.json' --valid",
    "test:quiet": "npm-run-all test:unit test:contract:quiet",
    "test:contract": "TZ=UTC npm-run-all -c start:background mocha:contract stop:background",
    "test:contract:quiet": "TZ=UTC npm-run-all -c start:background:quiet mocha:contract stop:background:quiet",
    "test:unit": "TZ=UTC npm-run-all lint mocha:unit:clear:coverage mocha:unit:coverage",
    "test:reseed": "npm-run-all db:reseed test"
  },
  "nyc": {
    "check-coverage": true,
    "per-file": true,
    "lines": 0,
    "statements": 0,
    "functions": 0,
    "branches": 0,
    "exclude": [
      "**/*.test.js",
      "**/*.test.jsx",
      "test/*"
    ],
    "reporter": [
      "lcov"
    ],
    "cache": false,
    "all": true,
    "report-dir": "./coverage"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "./{src,test,migrations,seeds}/**/*.js": [
      "eslint --fix --max-warnings 0"
    ],
    "./*.js": [
      "eslint --fix --max-warnings 0"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "author": "SystemOne",
  "license": "ISC",
  "dependencies": {
    "@hapi/basic": "^6.0.0",
    "@hapi/boom": "^9.1.0",
    "@hapi/hapi": "^19.1.1",
    "@hapi/inert": "^6.0.1",
    "@hapi/joi": "^17.1.1",
    "@hapi/vision": "^6.0.0",
    "ajv": "^8.2.0",
    "ajv-cli": "^3.1.0",
    "ajv-keywords": "^5.0.0",
    "amqplib": "^0.5.6",
    "babel-eslint": "^10.1.0",
    "base32": "^0.0.6",
    "bcrypt": "5.0.0",
    "bluebird": "^3.7.2",
    "date-fns": "^2.13.0",
    "date-fns-timezone": "^0.1.4",
    "debug": "^4.1.1",
    "deep-equal-in-any-order": "^1.1.7",
    "dotenv-safe": "^8.2.0",
    "email-templates": "7.0.4",
    "exceljs": "^3.9.0",
    "firebase-admin": "^9.2.0",
    "flat": "^5.0.0",
    "fs-extra": "^9.0.0",
    "google-libphonenumber": "^3.2.9",
    "handlebars": "^4.7.6",
    "hapi-auth-jwt2": "^10.1.0",
    "hapi-raven": "^7.0.1",
    "hapi-swagger": "^13.0.0",
    "http-client": "^4.3.1",
    "isomorphic-fetch": "^2.2.1",
    "json2csv": "^5.0.1",
    "jsonwebtoken": "^8.5.1",
    "knex": "^0.21.1",
    "lodash": "^4.17.19",
    "mysql": "^2.18.1",
    "node-base64-image": "^1.0.7",
    "node-cron": "^2.0.3",
    "node-uuid": "^1.4.8",
    "nodemailer": "^6.4.6",
    "object-mapper": "^6.2.0",
    "phone": "^2.4.11",
    "pug": "^2.0.4",
    "raven": "^2.6.4",
    "shx": "^0.3.2",
    "timezone-support": "^2.0.2",
    "twilio": "^3.55.0",
    "vision": "^5.4.4",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "chai": "^4.2.0",
    "chai-as-promised": "^7.1.1",
    "chai-subset": "^1.6.0",
    "eslint": "^7.23.0",
    "eslint-config-airbnb-base": "^14.1.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-no-only-tests": "^2.4.0",
    "eslint-plugin-prettier": "^3.1.3",
    "forever": "^2.0.0",
    "fs-extra-cli": "^0.0.4",
    "husky": "^4.2.5",
    "jwt-decode": "^2.2.0",
    "lint-staged": "^10.2.2",
    "mocha": "^7.1.2",
    "mocha-bamboo-reporter": "^1.1.2",
    "mocha-multi": "^1.1.3",
    "nodemon": "^2.0.4",
    "npm-run-all": "^4.1.5",
    "nyc": "^15.0.1",
    "prettier": "^2.0.5",
    "proxyquire": "^2.1.3",
    "shx": "^0.3.2",
    "sinon": "^9.0.2",
    "supertest": "^4.0.2"
  }
}
