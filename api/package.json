{
  "name": "aspect-api",
  "version": "1.0.0",
  "description": "The API for aspect clients",
  "main": "server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:background": "forever start src/server.js",
    "stop:background": "forever stop src/server.js",
    "mocha": "mocha --opts test/contract_tests/utils/mocha.opts",
    "test": "npm-run-all -c start:background mocha stop:background",
    "coverage": "./node_modules/istanbul/lib/cli.js cover --preload-sources ./node_modules/mocha/bin/_mocha -- --opts mocha_unit.opts -t 5000",
    "knex": "knex"
  },
  "author": "SystemOne",
  "license": "ISC",
  "dependencies": {
    "bluebird": "^3.4.3",
    "boom": "^4.0.0",
    "camelize": "^1.0.0",
    "decamelize": "^1.2.0",
    "dotenv-safe": "^2.3.1",
    "good": "^7.0.2",
    "good-console": "^6.1.2",
    "good-logstash": "^2.0.0",
    "good-squeeze": "^4.0.0",
    "hapi": "^15.0.2",
    "hapi-auth-jwt2": "^7.1.2",
    "hapi-raven": "^4.3.1",
    "hapi-swagger": "^7.1.0",
    "inert": "^4.0.2",
    "joi": "^9.0.4",
    "jsonwebtoken": "^7.1.0",
    "knex": "^0.11.10",
    "lodash": "^4.15.0",
    "moment": "^2.13.0",
    "mysql": "^2.11.1",
    "node-uuid": "^1.4.7",
    "raven": "^0.12.1",
    "vision": "^4.1.0"
  },
  "devDependencies": {
    "chai": "^3.5.0",
    "eslint": "^3.3.0",
    "forever": "^0.15.2",
    "mocha": "^3.0.0",
    "mocha-bamboo-reporter": "^1.1.1",
    "mocha-multi": "^0.9.1",
    "npm-run-all": "^3.0.0",
    "supertest": "^2.0.0"
  }
