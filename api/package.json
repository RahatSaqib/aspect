{
  "name": "aspect-api",
  "private": true,
  "version": "0.9.1",
  "description": "The API for aspect clients",
  "main": "server.js",
  "scripts": {
    "db:recreate": "node ./migrations/utils/recreateDB",
    "db:reseed": "npm-run-all db:recreate knex:migrate:latest knex:seed:run",
    "knex": "knex",
    "knex:migrate:latest": "knex migrate:latest",
    "knex:seed:run": "knex seed:run",
    "lint": "eslint ./src ./test ./migrations ./seeds ./knexfile.js --ext .js",
    "mocha:contract": "mocha --opts test/contract.mocha.opts",
    "mocha:unit": "mocha --opts test/unit.mocha.opts",
    "mocha:unit:clear:coverage": "fsys --task=remove --fileFolder=coverage && fsys --task=remove --fileFolder=mocha.json",
    "mocha:unit:coverage": "nyc mocha --opts test/unit.mocha.opts",
    "poststop:background": "shx echo API LOGS: && shx echo ------------------------------------------------------------- && shx cat out.log && shx echo API ERRORS: && shx echo ------------------------------------------------------------- && shx cat err.log",
    "prestart:background": "fsys --task=remove --fileFolder=out.log && fsys --task=remove --fileFolder=err.log",
    "prettier": "prettier --no-semi --single-quote --trailing-comma=es5",
    "prettier:write": "npm run prettier -- --write \"{migrations,seeds,src,test}/**/*.js\"",
    "start": "nodemon src/server.js",
    "start:background": "forever start -o out.log -e err.log src/server.js",
    "start:background:quiet": "forever start src/server.js",
    "stop:background": "forever stop src/server.js",
    "stop:background:quiet": "forever stop src/server.js",
    "test": "npm-run-all test:unit test:contract",
    "test:quiet": "npm-run-all test:unit test:contract:quiet",
    "test:contract": "npm-run-all -c start:background mocha:contract stop:background",
    "test:contract:quiet": "npm-run-all -c start:background:quiet mocha:contract stop:background:quiet",
    "test:unit": "npm-run-all lint mocha:unit:clear:coverage mocha:unit:coverage",
    "test:reseed": "npm-run-all db:reseed test"
  },
  "nyc": {
    "check-coverage": true,
    "per-file": true,
    "lines": 0,
    "statements": 0,
    "functions": 0,
    "branches": 0,
    "exclude": [
      "**/*.test.js",
      "**/*.test.jsx",
      "test/*"
    ],
    "reporter": [
      "lcov"
    ],
    "cache": false,
    "all": true,
    "report-dir": "./coverage"
  },
  "lint-staged": {
    "./src/**/*.js": [
      "eslint --fix",
      "git add"
    ],
    "./test/**/*.js": [
      "eslint --fix",
      "git add"
    ],
    "./migrations/**/*.js": [
      "eslint --fix",
      "git add"
    ],
    "./seeds/**/*.js": [
      "eslint --fix",
      "git add"
    ],
    "./*.js": [
      "eslint --fix",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
        "pre-commit": "lint-staged"
    }
  },
  "author": "SystemOne",
  "license": "ISC",
  "dependencies": {
    "@hapi/basic": "^5.1.1",
    "@hapi/boom": "^8.0.1",
    "@hapi/hapi": "^18.4.0",
    "@hapi/inert": "^5.2.2",
    "@hapi/joi": "^15.1.1",
    "@hapi/vision": "^5.5.4",
    "amqplib": "^0.5.5",
    "babel-eslint": "^10.0.3",
    "base32": "^0.0.6",
    "bcrypt": "3.0.6",
    "date-fns": "2.8.1",
    "date-fns-timezone": "^0.1.4",
    "debug": "^4.1.1",
    "dotenv-safe": "^8.2.0",
    "email-templates": "^2.7.1",
    "exceljs": "^3.4.0",
    "firebase-admin": "^8.8.0",
    "flat": "^5.0.0",
    "fs-extra": "^8.1.0",
    "google-libphonenumber": "^3.2.6",
    "handlebars": "^4.5.3",
    "hapi": "^18.1.0",
    "hapi-auth-basic": "^5.0.0",
    "hapi-auth-jwt2": "^8.8.1",
    "hapi-raven": "^7.0.1",
    "hapi-swagger": "^11.0.1",
    "http-client": "^4.3.1",
    "inert": "^5.1.3",
    "isomorphic-fetch": "^2.2.1",
    "json2csv": "^4.5.4",
    "jsonwebtoken": "^8.5.1",
    "knex": "^0.20.3",
    "lodash": "^4.17.15",
    "mysql": "^2.17.1",
    "node-base64-image": "^1.0.6",
    "node-cron": "^2.0.3",
    "node-uuid": "^1.4.8",
    "nodemailer": "^6.3.1",
    "phone": "^2.4.3",
    "raven": "^2.6.4",
    "shx": "^0.3.2",
    "timezone-support": "^2.0.2",
    "twilio": "^3.37.1",
    "vision": "^5.4.4"
  },
  "devDependencies": {
    "chai": "^4.2.0",
    "chai-subset": "^1.6.0",
    "eslint": "^6.7.2",
    "eslint-config-airbnb": "^18.0.1",
    "eslint-config-prettier": "^6.7.0",
    "eslint-plugin-import": "^2.18.2",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-prettier": "^3.1.1",
    "eslint-plugin-react": "^7.17.0",
    "forever": "^1.0.0",
    "fs-extra-cli": "^0.0.4",
    "husky": "^3.1.0",
    "jwt-decode": "^2.2.0",
    "lint-staged": "^9.5.0",
    "mocha": "^6.2.2",
    "mocha-bamboo-reporter": "^1.1.2",
    "mocha-multi": "^1.1.3",
    "nodemon": "^2.0.1",
    "npm-run-all": "^4.1.5",
    "nyc": "^14.1.1",
    "prettier": "^1.19.1",
    "proxyquire": "^2.1.3",
    "shx": "^0.3.2",
    "sinon": "^7.5.0",
    "supertest": "^4.0.2"
  }
}
