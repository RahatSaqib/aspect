{
  "name": "aspect-api",
  "private": true,
  "version": "0.0.1",
  "description": "The API for aspect clients",
  "main": "server.js",
  "scripts": {
    "lint": "eslint ./src ./migrations ./knexfile.js --ext .js",
    "mocha:unit": "mocha --opts test/unit.mocha.opts",
    "mocha:unit:clear:coverage": "fsys --task=remove --fileFolder=coverage && fsys --task=remove --fileFolder=mocha.json",
    "mocha:unit:coverage": "istanbul cover --config test/istanbul.yml node_modules/mocha/bin/_mocha -- --opts test/unit.mocha.opts",
    "mocha:unit:check:coverage": "istanbul check-coverage --config test/istanbul.yml",
    "test:unit": "npm-run-all lint mocha:unit:clear:coverage mocha:unit:coverage mocha:unit:check:coverage",
    "start": "node src/server.js",
    "start:background": "forever start src/server.js",
    "stop:background": "forever stop src/server.js",
    "mocha:contract": "mocha --opts test/contract.mocha.opts",
    "test:contract": "npm-run-all -c start:background mocha:contract stop:background",
    "test": "npm-run-all test:unit test:contract",
    "knex": "knex"
  },
  "author": "SystemOne",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^0.8.7",
    "bluebird": "^3.4.3",
    "boom": "^4.2.0",
    "dotenv-safe": "^2.3.1",
    "email-templates": "^2.5.3",
    "good": "^7.0.2",
    "good-console": "^6.3.1",
    "good-logstash": "^2.0.2",
    "good-squeeze": "^5.0.0",
    "handlebars": "^4.0.5",
    "hapi": "^15.2.0",
    "hapi-auth-jwt2": "^7.1.2",
    "hapi-raven": "^4.3.1",
    "hapi-swagger": "^7.4.0",
    "http-client": "^4.3.1",
    "inert": "^4.0.2",
    "isomorphic-fetch": "^2.2.1",
    "joi": "^9.2.0",
    "jsonwebtoken": "^7.1.0",
    "knex": "^0.12.6",
    "lodash": "^4.16.4",
    "moment": "^2.15.2",
    "mysql": "^2.11.1",
    "node-base64-image": "^1.0.1",
    "node-uuid": "^1.4.7",
    "raven": "^0.12.1",
    "sendgrid": "^4.7.1",
    "vision": "^4.1.0"
  },
  "devDependencies": {
    "chai": "^3.5.0",
    "eslint": "^3.10.1",
    "eslint-config-airbnb": "^13.0.0",
    "eslint-plugin-import": "^2.2.0",
    "eslint-plugin-jsx-a11y": "^2.2.3",
    "eslint-plugin-react": "^6.7.0",
    "forever": "^0.15.2",
    "fs-extra-cli": "0.0.4",
    "istanbul": "^0.4.5",
    "mocha": "^3.1.2",
    "mocha-bamboo-reporter": "^1.1.1",
    "mocha-multi": "^0.9.1",
    "npm-run-all": "^3.1.1",
    "proxyquire": "^1.7.10",
    "sinon": "^1.17.5",
    "supertest": "^2.0.1"
  }
}
