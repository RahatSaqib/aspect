{
  "name": "aspect-api",
  "private": true,
  "version": "1.74.2",
  "description": "The API for aspect clients",
  "main": "server.js",
  "scripts": {
    "db:recreate": "node ./migrations/utils/recreateDB",
    "db:recreateCI": "node ./migrations/utils/recreateDBCI",
    "db:migrate": "npm-run-all knex:migrate:latest knex:seed:run",
    "db:reseed": "npm-run-all db:recreate db:migrate",
    "db:reseedCI": "npm-run-all db:recreateCI db:migrate",
    "db:drop": "node ./migrations/utils/dropDB",
    "debug": "cross-env TZ=UTC nodemon --trace-warnings --inspect src/server.js",
    "doc": "node ./src/generateDoc",
    "knex": "knex",
    "knex:migrate:latest": "knex migrate:latest",
    "knex:seed:run": "knex seed:run",
    "lint": "eslint ./src ./test ./migrations ./seeds ./knexfile.js --ext .js",
    "lint:fix": "eslint ./src ./test ./migrations ./seeds ./knexfile.js --ext .js --fix",
    "lint:changes": "eslint $(git diff --name-only --diff-filter=ACM | grep -E '\\.(js|ts|jsx|tsx)$' | sed 's|^|../|') --fix",
    "mocha:contract": "cross-env TZ=UTC mocha --config test/contract.mocharc.js ",
    "mocha:contract:ci": "cross-env TZ=UTC mocha --config test/ci-contract.mocharc.js",
    "mocha:unit": "cross-env TZ=UTC mocha --config test/unit.mocharc.js",
    "mocha:unit:clear:coverage": "fsys --task=remove --fileFolder=coverage && fsys --task=remove --fileFolder=mocha.json",
    "mocha:unit:coverage": "nyc mocha --config test/unit.mocharc.js",
    "mocha:unit:coverage:ci": "nyc mocha --config test/ci-unit.mocharc.js",
    "poststop:background": "shx echo API LOGS: && shx echo ------------------------------------------------------------- && shx cat out.log && shx echo API ERRORS: && shx echo ------------------------------------------------------------- && shx cat err.log",
    "prestart:background": "fsys --task=remove --fileFolder=out.log && fsys --task=remove --fileFolder=err.log",
    "prettier": "prettier ./src/**/*.js ./test/**/*.js ./migrations/**/*.js ./seeds/**/*.js ./knexfile.js",
    "prettier:write": "yarn prettier --write",
    "start": "cross-env TZ=UTC nodemon src/server.js",
    "start:background:pm2": "yarn && pm2 start src/server.js",
    "start:background": "forever start -o out.log -e err.log src/server.js",
    "start:background:quiet": "forever start src/server.js",
    "start:fresh": "yarn && yarn db:reseed && yarn start",
    "start:ci": "node src/server.js",
    "install:ci": "yarn && yarn db:reseed",
    "stop:background:pm2": "pm2 stop src/server.js",
    "stop:background": "forever stop src/server.js",
    "stop:background:quiet": "forever stop src/server.js",
    "test": "npm-run-all test:json test:unit test:contract",
    "test:json": "ajv test -s jsonSchemas/dynamicFormSchema.json -d 'src/forms/formsDefinition/*.json' --valid",
    "test:quiet": "npm-run-all test:unit test:contract:quiet",
    "test:contract": "cross-env TZ=UTC npm-run-all -c start:background mocha:contract stop:background",
    "test:contract:quiet": "cross-env TZ=UTC npm-run-all -c start:background:quiet mocha:contract stop:background:quiet",
    "test:unit": "cross-env TZ=UTC npm-run-all mocha:unit:clear:coverage mocha:unit:coverage",
    "test:unit:ci": "cross-env TZ=UTC npm-run-all mocha:unit:clear:coverage mocha:unit:coverage:ci",
    "test:reseed": "npm-run-all db:reseed test",
    "gx:importZip": "node ./migrations/utils/importZipFilesFromGxAlert",
    "gx:processZip": "node ./migrations/utils/processJsonFilesFromGxAlert"
  },
  "nyc": {
    "check-coverage": true,
    "per-file": true,
    "lines": 0,
    "statements": 0,
    "functions": 0,
    "branches": 0,
    "exclude": [
      "**/*.test.js",
      "**/*.test.jsx",
      "test/*"
    ],
    "reporter": [
      "lcov"
    ],
    "cache": false,
    "all": true,
    "report-dir": "./coverage"
  },
  "author": "SystemOne",
  "license": "ISC",
  "dependencies": {
    "@hapi/basic": "^7.0.0",
    "@hapi/boom": "^10.0.0",
    "@hapi/hapi": "^21.1.0",
    "@hapi/inert": "^7.1.0",
    "@hapi/joi": "^17.1.1",
    "@hapi/vision": "^7.0.1",
    "@sentry/node": "7.120.3",
    "@sentry/tracing": "7.120.3",
    "@slack/web-api": "^6.9.1",
    "adm-zip": "^0.5.10",
    "ajv": "^8.11.2",
    "ajv-cli": "^5.0.0",
    "ajv-keywords": "^5.1.0",
    "amqplib": "^0.8.0",
    "aws-sdk": "^2.1688.0",
    "base32": "^0.0.7",
    "bcrypt": "5.1.0",
    "bluebird": "^3.7.2",
    "bullmq": "5.12.10",
    "date-fns": "^2.29.3",
    "date-fns-timezone": "^0.1.4",
    "date-fns-tz": "^2.0.0",
    "debug": "^4.3.4",
    "deep-equal-in-any-order": "^2.0.6",
    "dotenv-safe": "^8.2.0",
    "email-templates": "10.0.1",
    "exceljs": "^4.3.0",
    "firebase-admin": "^11.5.0",
    "flat": "^5.0.2",
    "fs-extra": "^11.2.0",
    "google-libphonenumber": "^3.2.32",
    "handlebars": "^4.7.7",
    "hapi-auth-jwt2": "^10.2.0",
    "hapi-raven": "^7.0.1",
    "hapi-swagger": "^16.0.1",
    "http-client": "^4.3.1",
    "ioredis": "5.4.1",
    "isomorphic-fetch": "^3.0.0",
    "json2csv": "^5.0.7",
    "jsonwebtoken": "^9.0.0",
    "knex": "^2.3.0",
    "lodash": "^4.17.21",
    "media-type": "^1.0.1",
    "mysql": "^2.18.1",
    "newrelic": "10.2.0",
    "node-base64-image": "^2.0.4",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.2",
    "node-fetch": "^2.6.7",
    "node-uuid": "^1.4.8",
    "nodemailer": "^6.8.0",
    "object-mapper": "^6.2.0",
    "phone": "^3.1.42",
    "pug": "^3.0.2",
    "raven": "^2.6.4",
    "shx": "^0.3.4",
    "timezone-support": "^3.1.0",
    "twilio": "^4.10.0",
    "vision": "^5.4.4",
    "windows-iana": "^5.1.0",
    "winston": "3.17.0",
    "winston-mail": "^2.0.0",
    "winston-transport-sentry-node": "^3.0.0",
    "xlsx-populate": "^1.21.0"
  },
  "devDependencies": {
    "chai": "^4.3.7",
    "chai-as-promised": "^7.1.1",
    "chai-subset": "^1.6.0",
    "cross-env": "7.0.3",
    "eslint": "^8.40.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-lodash": "^7.4.0",
    "eslint-plugin-mocha": "^10.1.0",
    "eslint-plugin-no-only-tests": "^3.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-security": "^1.7.1",
    "forever": "^4.0.3",
    "fs-extra-cli": "^0.0.4",
    "jwt-decode": "^3.1.2",
    "make-runnable": "^1.4.1",
    "mocha": "10.8.2",
    "mocha-json-output-reporter": "^2.1.0",
    "mocha-multi": "^1.1.7",
    "nodemon": "3.1.7",
    "npm-run-all": "^4.1.5",
    "nyc": "^15.1.0",
    "pm2": "5.4.2",
    "prettier": "^2.8.8",
    "proxyquire": "^2.1.3",
    "shx": "^0.3.4",
    "sinon": "17.0.1",
    "supertest": "^6.3.3"
  },
  "resolutions": {
    "minimist": "1.2.6",
    "lodash": "^4.17.21",
    "ansi-regex": "5.0.1",
    "moment": "^2.29.2",
    "async": "3.2.3",
    "y18n": "4.0.1",
    "nconf": "^0.11.4",
    "glob-parent": "^5.1.2",
    "node-fetch": "^2.6.7",
    "node-forge": "1.3.0",
    "protobufjs": "6.11.3",
    "dicer": "0.3.1"
  }
}
