{
  "name": "aspect-api",
  "private": true,
  "version": "0.0.1",
  "description": "The API for aspect clients",
  "main": "server.js",
  "scripts": {
    "lint": "eslint ./src ./test ./migrations ./seeds ./knexfile.js --ext .js",
    "mocha:unit": "mocha --opts test/unit.mocha.opts",
    "mocha:unit:clear:coverage": "fsys --task=remove --fileFolder=coverage && fsys --task=remove --fileFolder=mocha.json",
    "mocha:unit:coverage": "istanbul cover --config test/istanbul.yml node_modules/mocha/bin/_mocha -- --opts test/unit.mocha.opts",
    "mocha:unit:check:coverage": "istanbul check-coverage --config test/istanbul.yml",
    "test:unit": "npm-run-all lint mocha:unit:clear:coverage mocha:unit:coverage mocha:unit:check:coverage",
    "start": "node src/server.js",
    "prestart:background": "fsys --task=remove --fileFolder=out.log && fsys --task=remove --fileFolder=err.log",
    "start:background": "forever start -o out.log -e err.log src/server.js",
    "stop:background": "forever stop src/server.js",
    "poststop:background": "shx echo API LOGS: && shx echo ------------------------------------------------------------- && shx cat out.log && shx echo API ERRORS: && shx echo ------------------------------------------------------------- && shx cat err.log",
    "prettier": "prettier --no-semi --single-quote --trailing-comma=es5",
    "mocha:contract": "mocha --opts test/contract.mocha.opts",
    "test:contract": "npm-run-all -c start:background mocha:contract stop:background",
    "test": "npm-run-all test:unit test:contract",
    "knex": "knex"
  },
  "author": "SystemOne",
  "license": "ISC",
  "dependencies": {
    "base32": "^0.0.6",
    "bcrypt": "^1.0.2",
    "bluebird": "^3.4.3",
    "boom": "^4.2.0",
    "date-fns": "^1.27.2",
    "dotenv-safe": "^4.0.3",
    "email-templates": "^2.5.4",
    "exceljs": "^0.2.38",
    "good": "^7.1.0",
    "good-console": "^6.2.0",
    "good-logstash": "^2.0.2",
    "good-squeeze": "^5.0.1",
    "handlebars": "^4.0.6",
    "hapi": "^16.1.0",
    "hapi-auth-jwt2": "^7.2.4",
    "hapi-raven": "^5.0.0",
    "hapi-swagger": "^7.6.0",
    "http-client": "^4.3.1",
    "inert": "^4.1.0",
    "isomorphic-fetch": "^2.2.1",
    "joi": "^10.2.1",
    "json2csv": "^3.7.3",
    "jsonwebtoken": "^7.2.1",
    "knex": "^0.12.6",
    "lodash": "^4.17.4",
    "mysql": "^2.13.0",
    "node-base64-image": "^1.0.1",
    "node-uuid": "^1.4.7",
    "raven": "^1.1.1",
    "sendgrid": "^4.7.1",
    "vision": "^4.1.1"
  },
  "devDependencies": {
    "chai": "^3.5.0",
    "eslint": "^3.15.0",
    "eslint-config-airbnb": "^14.1.0",
    "eslint-plugin-import": "^2.2.0",
    "eslint-plugin-jsx-a11y": "^4.0.0",
    "eslint-plugin-react": "^6.9.0",
    "forever": "^0.15.2",
    "fs-extra-cli": "0.0.4",
    "istanbul": "^0.4.5",
    "mocha": "^3.2.0",
    "mocha-bamboo-reporter": "^1.1.1",
    "mocha-multi": "^0.10.0",
    "nodemon": "^1.11.0",
    "npm-run-all": "^4.0.1",
    "prettier": "^1.5.2",
    "proxyquire": "^1.7.11",
    "shx": "^0.2.2",
    "sinon": "^1.17.7",
    "supertest": "^3.0.0"
  }
}
