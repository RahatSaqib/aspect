{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "New Aspect Deployment",
  "Parameters": {
    "DeploymentName": {
      "Type": "String",
      "Default": "malawi"
    },
    "RDSMasterPassword": {
      "NoEcho": "true",
      "Type": "String",
      "Default": "MyPassword"
    },
    "AvailabilityZone": {
      "Type": "String",
      "Default": "us-east-1c"
    }
  },
  "Resources": {
    "AspectVPC": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "172.31.0.0/16",
        "InstanceTenancy": "default",
        "EnableDnsSupport": "true",
        "EnableDnsHostnames": "true",
        "Tags": [{
          "Key": "Name",
          "Value": { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, "_AspectVPC"]] }
        }]
      }
    },
    "AspectSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "CidrBlock": "172.31.48.0/20",
        "AvailabilityZone": {
          "Ref": "AvailabilityZone"
        },
        "VpcId": {
          "Ref": "AspectVPC"
        },
        "Tags": [{
          "Key": "Name",
          "Value": { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, "_AspectSubnet1"]] }
        }]
      }
    },
    "AspectSubnet2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "CidrBlock": "172.31.16.0/20",
        "AvailabilityZone": {
          "Ref": "AvailabilityZone"
        },
        "VpcId": {
          "Ref": "AspectVPC"
        },
        "Tags": [{
          "Key": "Name",
          "Value": { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, "_AspectSubnet2"]] }
        }]
      }
    },
    "AspectSubnet3": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "CidrBlock": "172.31.32.0/20",
        "AvailabilityZone": {
          "Ref": "AvailabilityZone"
        },
        "VpcId": {
          "Ref": "AspectVPC"
        },
        "Tags": [{
          "Key": "Name",
          "Value": { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, "_AspectSubnet3"]] }
        }]
      }
    },
    "AspectSubnet4": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "CidrBlock": "172.31.0.0/20",
        "AvailabilityZone": {
          "Ref": "AvailabilityZone"
        },
        "VpcId": {
          "Ref": "AspectVPC"
        },
        "Tags": [{
          "Key": "Name",
          "Value": { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, "_AspectSubnet4"]] }
        }]
      }
    },

    "AspectDBSubnetGroup": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, " Aspect DB Subnet Group"]] },
        "SubnetIds": [
          {
            "Ref": "AspectSubnet1"
          },
          {
            "Ref": "AspectSubnet2"
          },
          {
            "Ref": "AspectSubnet3"
          },
          {
            "Ref": "AspectSubnet4"
          }
        ],
        "Tags": [{
          "Key": "Name",
          "Value": { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, "_AspectDBSubnetGroup"]] }
        }]
      }
    },
    "AspectDBSubnetGroupDev": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": { "Fn::Join": ["", ["Subnet Group for developer access to ", { "Ref": "DeploymentName" }, " Aspect RDS"]] },
        "SubnetIds": [
          {
            "Ref": "AspectSubnet1"
          },
          {
            "Ref": "AspectSubnet2"
          },
          {
            "Ref": "AspectSubnet3"
          },
          {
            "Ref": "AspectSubnet4"
          }
        ],
        "Tags": [{
          "Key": "Name",
          "Value": { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, "_AspectDBSubnetGroupDev"]] }
        }]
      }
    },

    "AspectAPIEnv": {
      "Type": "AWS::ElasticBeanstalk::Environment",
      "Properties": {
        "ApplicationName": "aspect-api",
        "SolutionStackName": "64bit Amazon Linux 2016.09 v3.1.0 running Node.js",
        "Tier": {
          "Name": "WebServer",
          "Type": "Standard"
        },
        "OptionSettings": [
          {
            "Namespace": "aws:autoscaling:launchconfiguration",
            "OptionName": "EC2KeyName",
            "Value": "aws-eb"
          },
          {
            "Namespace": "aws:autoscaling:launchconfiguration",
            "OptionName": "IamInstanceProfile",
            "Value": "aws-elasticbeanstalk-ec2-role"
          },
          {
            "Namespace": "aws:autoscaling:launchconfiguration",
            "OptionName": "ImageId",
            "Value": "ami-d8356acf"
          },
          {
            "Namespace": "aws:autoscaling:launchconfiguration",
            "OptionName": "InstanceType",
            "Value": "t2.micro"
          },
          {
            "Namespace": "aws:autoscaling:launchconfiguration",
            "OptionName": "SecurityGroups",
            "Value": "awseb-e-bxjjthxba2-stack-AWSEBSecurityGroup-U65SIA6X06FN"
          },
          {
            "Namespace": "aws:autoscaling:trigger",
            "OptionName": "UpperThreshold",
            "Value": "6000000"
          },
          {
            "Namespace": "aws:autoscaling:updatepolicy:rollingupdate",
            "OptionName": "MaxBatchSize",
            "Value": "1"
          },
          {
            "Namespace": "aws:autoscaling:updatepolicy:rollingupdate",
            "OptionName": "MinInstancesInService",
            "Value": "1"
          },
          {
            "Namespace": "aws:autoscaling:updatepolicy:rollingupdate",
            "OptionName": "RollingUpdateEnabled",
            "Value": "true"
          },
          {
            "Namespace": "aws:autoscaling:updatepolicy:rollingupdate",
            "OptionName": "RollingUpdateType",
            "Value": "Health"
          },
          {
            "Namespace": "aws:elasticbeanstalk:command",
            "OptionName": "BatchSize",
            "Value": "30"
          },
          {
            "Namespace": "aws:elasticbeanstalk:container:nodejs",
            "OptionName": "NodeVersion",
            "Value": "6.2.2"
          },
          {
            "Namespace": "aws:elasticbeanstalk:environment",
            "OptionName": "ServiceRole",
            "Value": "aws-elasticbeanstalk-service-role"
          },
          {
            "Namespace": "aws:elasticbeanstalk:healthreporting:system",
            "OptionName": "SystemType",
            "Value": "enhanced"
          },
          {
            "Namespace": "aws:elasticbeanstalk:managedactions",
            "OptionName": "ManagedActionsEnabled",
            "Value": "true"
          },
          {
            "Namespace": "aws:elasticbeanstalk:managedactions",
            "OptionName": "PreferredStartTime",
            "Value": "SUN:09:02"
          },
          {
            "Namespace": "aws:elasticbeanstalk:managedactions:platformupdate",
            "OptionName": "UpdateLevel",
            "Value": "minor"
          },
          {
            "Namespace": "aws:elb:healthcheck",
            "OptionName": "Interval",
            "Value": "10"
          },
          {
            "Namespace": "aws:elb:loadbalancer",
            "OptionName": "CrossZone",
            "Value": "true"
          },
          {
            "Namespace": "aws:elb:loadbalancer",
            "OptionName": "LoadBalancerHTTPPort",
            "Value": "80"
          },
          {
            "Namespace": "aws:elb:loadbalancer",
            "OptionName": "SecurityGroups",
            "Value": "sg-bd815bc0"
          },
          {
            "Namespace": "aws:elb:policies",
            "OptionName": "ConnectionDrainingEnabled",
            "Value": "true"
          }
        ],
        "Tags": [{
          "Key": "Name",
          "Value": { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, "_AspectAPIEnv"]] }
        }]
      }
    },

    "AspectCloudfront": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Aliases": [
            { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, ".aspect.id"]] }
          ],
          "Enabled": true,
          "DefaultRootObject": "index.html",
          "PriceClass": "PriceClass_All",
          "CustomErrorResponses": [
            {
              "ErrorCachingMinTTL": 5,
              "ErrorCode": 404,
              "ResponseCode": "200",
              "ResponsePagePath": "/index.html"
            }
          ],
          "CacheBehaviors": [
            {
              "TargetOriginId": { "Fn::Join": ["", ["S3-", { "Ref": "DeploymentName" }, "-aspect-web"]] },
              "PathPattern": "*.html",
              "ViewerProtocolPolicy": "allow-all",
              "MinTTL": 0,
              "AllowedMethods": [
                "HEAD",
                "GET"
              ],
              "CachedMethods": [
                "HEAD",
                "GET"
              ],
              "ForwardedValues": {
                "Cookies": {
                  "Forward": "none"
                }
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": { "Fn::Join": ["", ["S3-", { "Ref": "DeploymentName" }, "-aspect-web"]] },
            "ViewerProtocolPolicy": "allow-all",
            "MinTTL": 0,
            "AllowedMethods": [
              "HEAD",
              "GET"
            ],
            "CachedMethods": [
              "HEAD",
              "GET"
            ],
            "ForwardedValues": {
              "Cookies": {
                "Forward": "none"
              }
            }
          },
          "Origins": [
            {
              "DomainName": { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, "-aspect-web.s3.amazonaws.com"]] },
              "Id": { "Fn::Join": ["", ["S3-", { "Ref": "DeploymentName" }, "-aspect-web"]] },
              "S3OriginConfig": { }
            }
          ],
          "Restrictions": {
            "GeoRestriction": {
              "RestrictionType": "none",
              "Locations": []
            }
          },
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": "true",
            "MinimumProtocolVersion": "SSLv3"
          }
        },
        "Tags": [{
          "Key": "Name",
          "Value": { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, "_AspectCloudfront"]] }
        }]
      }
    },

    "AspectDBSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": { "Fn::Join": ["", ["Security group for access to ", { "Ref": "DeploymentName" }, " aspect DB in RDS"]] },
        "VpcId": {
          "Ref": "AspectVPC"
        },
        "Tags": [{
          "Key": "Name",
          "Value": { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, "_AspectDBSG"]] }
        }]
      }
    },

    "AspectRDS": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "AllocatedStorage": "10",
        "AllowMajorVersionUpgrade": "false",
        "AutoMinorVersionUpgrade": "true",
        "DBInstanceClass": "db.t2.micro",
        "Port": "3306",
        "PubliclyAccessible": "true",
        "StorageType": "gp2",
        "BackupRetentionPeriod": "35",
        "MasterUsername": "master",
        "MasterUserPassword": {
          "Ref": "RDSMasterPassword"
        },
        "PreferredBackupWindow": "01:00-01:30",
        "PreferredMaintenanceWindow": "sat:02:00-sat:03:00",
        "DBName": "aspect",
        "Engine": "mysql",
        "EngineVersion": "5.7.11",
        "LicenseModel": "general-public-license",
        "DBSubnetGroupName": {
          "Ref": "AspectDBSubnetGroup"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "AspectDBSG"
          }
        ],
        "Tags": [{
          "Key": "Name",
          "Value": { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, "_AspectRDS"]] }
        }, {
          "Key": "workload-type",
          "Value": "other"
        }]
      }
    },

    "AspectS3Web": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "AccessControl": "Private",
        "VersioningConfiguration": {
          "Status": "Suspended"
        },
        "Tags": [{
          "Key": "Name",
          "Value": { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, "_AspectS3Web"]] }
        }]
      }
    },

    "AspectIG": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [{
          "Key": "Name",
          "Value": { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, "_AspectIG"]] }
        }]
      }
    },
    "AspectDHCP": {
      "Type": "AWS::EC2::DHCPOptions",
      "Properties": {
        "DomainName": "ec2.internal",
        "DomainNameServers": [
          "AmazonProvidedDNS"
        ],
        "Tags": [{
          "Key": "Name",
          "Value": { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, "_AspectDHCP"]] }
        }]
      }
    },

    "AspectACL": {
      "Type": "AWS::EC2::NetworkAcl",
      "Properties": {
        "VpcId": {
          "Ref": "AspectVPC"
        },
        "Tags": [{
          "Key": "Name",
          "Value": { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, "_AspectACL"]] }
        }]
      }
    },

    "AspectRT": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "AspectVPC"
        },
        "Tags": [{
          "Key": "Name",
          "Value": { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, "_AspectRT"]] }
        }]
      }
    },

    "S3AspectConfigPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": "aspect-env-config",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Id": { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, "_S3AspectConfigPolicyID"]] },
          "Statement": [
            {
              "Sid": { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, "_S3AspectConfigPolicy_stmt"]] },
              "Effect": "Allow",
              "Principal": "*",
              "Action": "s3:GetObject",
              "Resource": { "Fn::Join": ["", ["arn:aws:s3:::aspect-env-config/", { "Ref": "DeploymentName" }, ".env"]] },
              "Condition": {
                "IpAddress": {
                  "aws:SourceIp": "52.44.26.14"
                }
              }
            },
            {
              "Sid": { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, "_s3_aspect_migration_config_policy_stmt"]] },
              "Effect": "Allow",
              "Principal": "*",
              "Action": "s3:GetObject",
              "Resource": { "Fn::Join": ["", ["arn:aws:s3:::aspect-env-config/", { "Ref": "DeploymentName" }, "_migrate.env"]] },
              "Condition": {
                "IpAddress": {
                  "aws:SourceIp": "52.44.26.14"
                }
              }
            }
          ]
        },
        "Tags": [{
          "Key": "Name",
          "Value": { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, "_S3AspectConfigPolicy"]] }
        }]
      }
    },

    "AspectS3WebPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "AspectS3Web"
        },
        "PolicyDocument": {
          "Version": "2008-10-17",
          "Statement": [
            {
              "Sid": "Gives read access to everyone",
              "Effect": "Allow",
              "Principal": {
                "AWS": "*"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    "arn:aws:s3:::",
                    {
                      "Ref": "AspectS3Web"
                    },
                    "/*"
                  ]
                ]
              }
            },
            {
              "Sid": "Gives listing folder contents to everyone",
              "Effect": "Allow",
              "Principal": {
                "AWS": "*"
              },
              "Action": "s3:ListBucket",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    "arn:aws:s3:::",
                    {
                      "Ref": "AspectS3Web"
                    },
                    ""
                  ]
                ]
              }
            }
          ]
        },
        "Tags": [{
          "Key": "Name",
          "Value": { "Fn::Join": ["", [{ "Ref": "DeploymentName" }, "_AspectS3WebPolicy"]] }
        }]
      }
    },


