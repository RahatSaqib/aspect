    "{PARAMETER:deployment_name}_s3_aspect_config_policy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": "aspect-env-config",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Id": "{PARAMETER:deployment_name}_s3_aspect_config_policy_id",
          "Statement": [
            {
              "Sid": "{PARAMETER:deployment_name}_s3_aspect_config_policy_stmt",
              "Effect": "Allow",
              "Principal": "*",
              "Action": "s3:GetObject",
              "Resource": "arn:aws:s3:::aspect-env-config/{PARAMETER:deployment_name}.env",
              "Condition": {
                "IpAddress": {
                  "aws:SourceIp": "52.44.26.14"
                }
              }
            },
            {
              "Sid": "{PARAMETER:deployment_name}_s3_aspect_migration_config_policy_stmt",
              "Effect": "Allow",
              "Principal": "*",
              "Action": "s3:GetObject",
              "Resource": "arn:aws:s3:::aspect-env-config/{PARAMETER:deployment_name}_migrate.env",
              "Condition": {
                "IpAddress": {
                  "aws:SourceIp": "52.44.26.14"
                }
              }
            }
          ]
        }
      }
    },

    "{PARAMETER:deployment_name}_aspect_s3_web_policy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "{PARAMETER:deployment_name}_aspect_s3_web"
        },
        "PolicyDocument": {
          "Version": "2008-10-17",
          "Statement": [
            {
              "Sid": "Gives read access to everyone",
              "Effect": "Allow",
              "Principal": {
                "AWS": "*"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    "arn:aws:s3:::",
                    {
                      "Ref": "{PARAMETER:deployment_name}_aspect_s3_web"
                    },
                    "/*"
                  ]
                ]
              }
            },
            {
              "Sid": "Gives listing folder contents to everyone",
              "Effect": "Allow",
              "Principal": {
                "AWS": "*"
              },
              "Action": "s3:ListBucket",
              "Resource": {
                "Fn::Join": [
                  "",
                  [
                    "arn:aws:s3:::",
                    {
                      "Ref": "{PARAMETER:deployment_name}_aspect_s3_web"
                    },
                    ""
                  ]
                ]
              }
            }
          ]
        }
      }
    },


