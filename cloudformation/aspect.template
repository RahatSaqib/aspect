    "{PARAMETER:deployment_name}_aspect_cloudfront": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Aliases": [
            "{PARAMETER:deployment_name}.aspect.id"
          ],
          "Enabled": true,
          "DefaultRootObject": "index.html",
          "PriceClass": "PriceClass_All",
          "CustomErrorResponses": [
            {
              "ErrorCachingMinTTL": 5,
              "ErrorCode": 404,
              "ResponseCode": "200",
              "ResponsePagePath": "/index.html"
            }
          ],
          "CacheBehaviors": [
            {
              "TargetOriginId": "S3-{PARAMETER:deployment_name}-aspect-web",
              "PathPattern": "*.html",
              "ViewerProtocolPolicy": "allow-all",
              "MinTTL": 0,
              "AllowedMethods": [
                "HEAD",
                "GET"
              ],
              "CachedMethods": [
                "HEAD",
                "GET"
              ],
              "ForwardedValues": {
                "Cookies": {
                  "Forward": "none"
                }
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "S3-{PARAMETER:deployment_name}-aspect-web",
            "ViewerProtocolPolicy": "allow-all",
            "MinTTL": 0,
            "AllowedMethods": [
              "HEAD",
              "GET"
            ],
            "CachedMethods": [
              "HEAD",
              "GET"
            ],
            "ForwardedValues": {
              "Cookies": {
                "Forward": "none"
              }
            }
          },
          "Origins": [
            {
              "DomainName": "{PARAMETER:deployment_name}-aspect-web.s3.amazonaws.com",
              "Id": "S3-{PARAMETER:deployment_name}-aspect-web",
              "S3OriginConfig": { }
            }
          ],
          "Restrictions": {
            "GeoRestriction": {
              "RestrictionType": "none",
              "Locations": []
            }
          },
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": "true",
            "MinimumProtocolVersion": "SSLv3"
          }
        }
      }
    },

    "{PARAMETER:deployment_name}_aspect_db_sg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
